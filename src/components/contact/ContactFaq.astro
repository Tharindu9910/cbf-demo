---
import ChevronDown from "@lucide/astro/icons/chevron-down";

import SectionHeading from "../about/SectionHeading.astro";
import { CONTACT } from "../../config/contact";

/**
 * The Contact page's FAQ: one expandable card per question, one open at a
 * time. A question without an answer is left out, and the section with it
 * if none have one.
 */
const { title, intro, items } = CONTACT.faq;
const faqs = items.filter((f) => f.a.trim());
---

{
  faqs.length > 0 && (
    <section id="faq" aria-labelledby="faq-heading" class="scroll-mt-24 bg-brand-ivory py-20 font-inter lg:py-28">
      <div class="mx-auto max-w-[860px] px-5 md:px-10">
        <div class="text-center">
          <SectionHeading id="faq-heading" title={title} align="center" data-reveal />
          <p data-reveal class="mx-auto mt-4 max-w-xl text-[17px] leading-[1.6] text-ink-body">
            {intro}
          </p>
        </div>
        <div data-reveal class="mt-12 flex flex-col gap-3">
          {faqs.map((faq) => (
            <details
              name="contact-faq"
              class="group rounded-[18px] bg-white ring-1 ring-brand-leaf/8 transition-shadow open:shadow-[0_18px_40px_-30px_rgb(30_50_20/0.45)]"
            >
              <summary class="flex min-h-[60px] cursor-pointer list-none items-center justify-between gap-6 rounded-[18px] px-5 py-4 text-[15px] leading-6 font-semibold text-ink-heading marker:hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-moss md:px-6 [&::-webkit-details-marker]:hidden">
                {faq.q}
                <ChevronDown
                  class="size-5 shrink-0 text-brand-moss transition-transform duration-300 ease-rise group-open:rotate-180 motion-reduce:transition-none"
                  stroke-width={1.8}
                  aria-hidden="true"
                />
              </summary>
              <p class="max-w-3xl px-5 pb-5 text-[14px] leading-[1.7] text-ink-body md:px-6">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
