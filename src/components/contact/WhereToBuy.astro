---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import MapPin from "@lucide/astro/icons/map-pin";

import SectionHeading from "../about/SectionHeading.astro";
import StoreLogo from "../stores/StoreLogo.astro";
import { CONTACT } from "../../config/contact";
import { retailersByGroup } from "../../config/products";
import { inquiryHref } from "../../config/site";

/**
 * "Where to Buy", the full version and the landing spot of every "Find a
 * Store" link (the other pages show logos only). Two groups from `RETAILERS`
 * (config/products.ts), both as the same centred cards: the logo in a round
 * badge, the name under it, then a supermarket's note and locator link or a
 * location's type, address, where inside and directions.
 * A group with no entries is left out, a field with no value hides its line,
 * and the subtext names only what is listed.
 */
const { title, intro, supermarkets: supermarketsTitle, others: othersTitle, branchLink, directions, prompt, promptLink } =
  CONTACT.whereToBuy;
const { supermarkets, others } = retailersByGroup();

const subtext =
  supermarkets.length && others.length
    ? intro.both
    : supermarkets.length
      ? intro.supermarkets
      : others.length
        ? intro.others
        : intro.none;

const groupTitle = "text-[0.75rem] leading-4 font-bold tracking-[0.1625rem] text-brand-fern uppercase";
/** Same columns for both groups, so every card is the same width. */
const grid = "mt-5 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5";
const card = "flex h-full flex-col items-center rounded-[1.5rem] bg-brand-ivory px-4 py-7 text-center ring-1 ring-brand-leaf/6";
const name = "mt-5 text-[1rem] leading-[1.35] font-semibold text-ink-heading";
const action =
  "group mt-auto inline-flex items-center gap-1.5 rounded-sm pt-4 text-[0.875rem] font-semibold text-brand-moss transition-colors hover:text-brand-leaf focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-brand-moss";
const external = { target: "_blank", rel: "noopener noreferrer" };
---

<section id="where-to-buy" aria-labelledby="where-heading" tabindex="-1" class="scroll-mt-24 bg-white py-20 outline-hidden lg:py-28">
  <div class="mx-auto max-w-page px-5 font-inter md:px-10">
    <div class="text-center">
      <SectionHeading id="where-heading" title={title} align="center" data-reveal />
      <p data-reveal class="mx-auto mt-4 max-w-xl text-[1.0625rem] leading-[1.6] text-ink-body">{subtext}</p>
    </div>

    {
      supermarkets.length > 0 && (
        <div data-reveal class="mt-14">
          <h3 class={groupTitle}>{supermarketsTitle}</h3>
          <ul class={grid}>
            {supermarkets.map((store) => (
              <li>
                <article class={card}>
                  <StoreLogo retailer={store} size="badge" />
                  <h4 class={name}>{store.name}</h4>
                  {store.note && <p class="mt-1.5 text-[0.875rem] leading-[1.5] text-ink-body">{store.note}</p>}
                  {store.link && (
                    <a href={store.link} {...external} class={action}>
                      {branchLink}
                      <ArrowUpRight class="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transition-none" stroke-width={2} aria-hidden="true" />
                      <span class="sr-only">at {store.name} (opens in a new tab)</span>
                    </a>
                  )}
                </article>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    {
      others.length > 0 && (
        <div data-reveal class="mt-14">
          <h3 class={groupTitle}>{othersTitle}</h3>
          <ul class={grid}>
            {others.map((place) => (
              <li>
                <article class={card}>
                  <StoreLogo retailer={place} size="badge" />
                  <h4 class={name}>{place.name}</h4>
                  {place.type && <p class="mt-1 text-[0.875rem] leading-5 text-ink-body/75">{place.type}</p>}
                  {(place.address || place.whereInside) && (
                    <dl class="mt-3 grid gap-1.5 text-[0.875rem] leading-[1.5] text-ink-body">
                      {place.address && (
                        <div class="flex justify-center gap-1.5">
                          <dt>
                            <MapPin class="mt-0.5 size-4 text-brand-moss" stroke-width={1.8} aria-hidden="true" />
                            <span class="sr-only">Address</span>
                          </dt>
                          <dd>{place.address}</dd>
                        </div>
                      )}
                      {place.whereInside && (
                        <div>
                          <dt class="inline font-semibold text-ink-heading">Find it: </dt>
                          <dd class="inline">{place.whereInside}</dd>
                        </div>
                      )}
                    </dl>
                  )}
                  {place.link && (
                    <a href={place.link} {...external} class={action}>
                      {directions}
                      <ArrowUpRight class="size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 motion-reduce:transition-none" stroke-width={2} aria-hidden="true" />
                      <span class="sr-only">to {place.name} (opens in a new tab)</span>
                    </a>
                  )}
                </article>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <p data-reveal class="mt-14 text-center text-[1rem] leading-6 text-ink-body">
      {prompt}{" "}
      <a
        href={inquiryHref({ intent: "general", topic: "stockist" })}
        data-intent="general"
        class="rounded-sm font-semibold text-brand-moss underline decoration-brand-moss/40 underline-offset-4 transition-colors hover:decoration-brand-moss focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-brand-moss"
      >{promptLink}</a
      >.
    </p>
  </div>
</section>
