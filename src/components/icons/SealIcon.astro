---
// Hand-drawn hero icon, 24px grid, 1.5 stroke. Decorative: always aria-hidden.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  <path d="m12 2.8 2.2 1.7 2.7-.4 1 2.6 2.4 1.4-.7 2.7.7 2.7-2.4 1.4-1 2.6-2.7-.4L12 21.2l-2.2-1.7-2.7.4-1-2.6-2.4-1.4.7-2.7-.7-2.7 2.4-1.4 1-2.6 2.7.4L12 2.8Z" />
  <circle cx="12" cy="12" r="3.1" />
</svg>
