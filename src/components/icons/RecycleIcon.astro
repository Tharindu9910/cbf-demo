---
// Hand-drawn hero icon, 24px grid, 1.5 stroke. Decorative: always aria-hidden.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  <path d="M12 3.5 14.6 8h-5.2L12 3.5Z" />
  <path d="M14.6 8h3.2a2 2 0 0 1 1.7 3l-1.4 2.4" />
  <path d="M6.6 13.4 4.5 17a2 2 0 0 0 1.7 3h2.9" />
  <path d="m9.4 8-2.8 5.4M18.1 13.4 20 17a2 2 0 0 1-1.7 3h-3" />
  <path d="m9.1 17.6 2 2.4-2 2.4" />
</svg>
