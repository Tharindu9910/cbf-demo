---
// Hand-drawn hero icon, 24px grid, 1.5 stroke. Decorative: always aria-hidden.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  <path d="M12 5v14M6 13l6 6 6-6" />
</svg>
