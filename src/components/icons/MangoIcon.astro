---
// Hand-drawn hero icon, 24px grid, 1.5 stroke. Decorative: always aria-hidden.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  <path d="M3.5 15.5c0-4.6 4.1-8.6 8.8-8.6 3.5 0 5.7 2.2 5.7 5.1 0 4.7-4.5 8.1-9.2 8.1-3.2 0-5.3-1.8-5.3-4.6Z" />
  <path d="M6.6 15.2c.3-2 1.7-3.8 3.7-4.7" />
  <path d="M15.3 7.4c.3-1.1 1-2 1.9-2.6" />
  <path d="M17.2 4.8c1.2-1 2.9-1.3 4.2-.7-.6 1.5-2.1 2.4-3.8 2.3" />
</svg>
