---
// Hand-drawn hero icon, 24px grid, 1.5 stroke. Decorative: always aria-hidden.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  <path d="M4.5 19.5c-1.5-5 .5-10 5-12.5 2.5-1.4 5.5-1.8 9-1.5.3 3.5-.1 6.5-1.5 9-2.5 4.5-7.5 6.5-12.5 5Z" />
  <path d="M4.5 19.5 14 10" />
</svg>
