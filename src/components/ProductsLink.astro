---
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
import { url } from "../config/url";

/**
 * The "View All Products" pill at the foot of `BrandIntro`. Points at the
 * Products page. Its own look rather than `PillLink`'s (a deep green gradient,
 * Outfit, a larger shadow), and sized in `BrandIntro`'s `--u`, so it only
 * renders inside that frame.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<a
  href={url("/products/")}
  class:list={[
    "group inline-flex h-[max(52px,calc(66*var(--u)))] items-center justify-center gap-[calc(14*var(--u))] rounded-full bg-linear-to-b from-intro-cta-top to-intro-cta-bottom px-[max(28px,calc(39*var(--u)))] font-outfit text-[length:max(15px,calc(20*var(--u)))] font-medium text-white shadow-intro-cta transition-[filter] hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-brand-moss motion-reduce:transition-none",
    className,
  ]}
>
  View All Products
  <ArrowRightIcon
    class="size-[max(16px,calc(18*var(--u)))] transition-transform duration-150 group-hover:translate-x-[3px] motion-reduce:transition-none"
  />
</a>
