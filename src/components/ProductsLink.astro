---
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
import { url } from "../config/url";

/**
 * The "View All Products" pill at the foot of `BrandIntro`. Points at the
 * Products page. The shared green `btn-glow` pill, but in Outfit rather than
 * `PillLink`'s Inter, and sized in `BrandIntro`'s `--u`, so it only renders
 * inside that frame.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<a
  href={url("/products/")}
  class:list={[
    "group inline-flex h-12 items-center justify-center gap-[max(8px,calc(14*var(--u)))] rounded-full px-7 sm:h-[max(52px,calc(66*var(--u)))] sm:px-[max(28px,calc(39*var(--u)))] font-outfit text-[length:max(15px,calc(20*var(--u)))] font-medium btn-glow focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-brand-moss",
    className,
  ]}
>
  View All Products
  <ArrowRightIcon
    class="size-[max(16px,calc(18*var(--u)))] transition-transform duration-150 group-hover:translate-x-[3px] motion-reduce:transition-none"
  />
</a>
