---
import { Image } from "astro:assets";

import ArrowRightIcon from "../icons/ArrowRightIcon.astro";
import { eyebrow, heading } from "../../styles/section";
import gotuKolaLeaves from "../../assets/images/gotu-kola/gotukola-leaves-hero.jpg";
import { url } from "../../config/url";

/**
 * "Why gotu kola": the same short block on every Thynkers page, the herb in
 * two lines beside its photo on a sage card. It links to the Gotukola page.
 */
interface Props {
  href?: string;
}

const { href = url("/gotukola/") } = Astro.props;
---

<section
  aria-labelledby="gotu-kola-block-heading"
  class="bg-brand-ivory pb-16 font-inter lg:pb-20"
>
  <div class="mx-auto max-w-page px-5 md:px-10">
    <div
      data-reveal
      class="grid items-center gap-6 rounded-[1.75rem] bg-brand-sage p-4 ring-1 ring-brand-leaf/6 sm:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] sm:gap-10 sm:p-5 lg:gap-14"
    >
      <div data-skeleton class="overflow-hidden rounded-[1.25rem]  p-1.5 shadow-[0_18px_40px_-28px_rgb(13_43_18/0.5)]">
        <Image
          src={gotuKolaLeaves}
          alt="Overhead view of a dense bed of fresh, round gotu kola leaves with water droplets"
          widths={[360, 560, 720]}
          sizes="(min-width: 1024px) 400px, (min-width: 640px) 36vw, 100vw"
          quality={80}
          loading="lazy"
          class="aspect-[16/9] w-full rounded-[1rem] object-cover sm:aspect-[4/3]"
        />
      </div>
      <div class="px-3 pb-5 sm:px-0 sm:py-6 sm:pr-8">
        <p class:list={[eyebrow, "text-brand-fern uppercase"]}>
          Why gotu kola
        </p>
        <h2
          id="gotu-kola-block-heading"
          class:list={[heading, "mt-3 text-ink-heading lg:text-[2.75rem]"]}
        >
          Nature&rsquo;s brain booster.
        </h2>
        <p class="mt-4 max-w-md text-[1rem] leading-[1.5625rem] text-ink-body">
          A centuries-old Ayurvedic herb, gotu kola has long been valued for
          focus and memory. Every can starts with Sri Lankan gotu kola extract.
        </p>
        <a
          href={href}
          class="group mt-3.5 inline-flex items-center gap-2 rounded-sm py-2.5 text-[0.9375rem] lg:mt-6 lg:fine:py-0 font-semibold text-brand-moss transition-colors hover:text-brand-moss-dark focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-moss"
        >
          Learn more<span class="sr-only"> about gotu kola</span>
          <ArrowRightIcon class="size-4 transition-transform group-hover:translate-x-1 motion-reduce:transition-none" />
        </a>
      </div>
    </div>
  </div>
</section>
