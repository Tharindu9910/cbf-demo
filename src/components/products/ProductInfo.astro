---
import { getEntry } from "astro:content";
import Candy from "@lucide/astro/icons/candy";
import FlaskConical from "@lucide/astro/icons/flask-conical";
import MapPin from "@lucide/astro/icons/map-pin";
import Minus from "@lucide/astro/icons/minus";
import Palette from "@lucide/astro/icons/palette";
import Plus from "@lucide/astro/icons/plus";
import Share2 from "@lucide/astro/icons/share-2";
import Sprout from "@lucide/astro/icons/sprout";

import PillLink from "../ui/PillLink.astro";
import StoreLogo from "../stores/StoreLogo.astro";
import { BENEFITS, RETAILERS } from "../../config/products";
import { inquiryHref } from "../../config/site";
import { getRange, productHref, type Product } from "./range";
import { getReviews, STAR_PATH } from "./reviews";
import { tintOf } from "./tint";

/**
 * The info panel beside the gallery: brand, name (the page's <h1>), tagline,
 * rating, summary, then the choices (flavour, pack, quantity), the two ways
 * to get it, the key facts, the range's promises and where it's stocked.
 *
 * There are no prices or basket: "Find in Store" and "Order Now" go to
 * the contact page. The flavour pills are links to the other flavours' pages
 * (and the Mixed Pack sits with the pack options). Choosing a pack updates
 * the size fact and the order link, and the quantity rides along on the
 * order (`scripts/products/productPage.ts`); without script the links
 * carry the first pack and no quantity.
 *
 * The Mixed Pack is a pack option on every flavour page too. Choosing it
 * opens "Build your pack": a stepper per flavour, up to the pack's can count.
 * The mix rides on the order once it adds up; until then Order Now waits.
 */
interface Props {
  product: Product;
}

const { id, data } = Astro.props.product;
const tint = tintOf(id);
const [firstPack] = data.packs;
const isPack = data.kind === "pack";

const range = await getRange();
const flavours = range.filter((p) => p.data.kind === "flavour");
// The pack the buyer fills (the Mixed Pack): a pack option on every flavour page.
const mixPack = isPack ? Astro.props.product : range.find((p) => p.data.mix);
const mix = mixPack?.data.mix;
const mixFlavours = mix
  ? (await Promise.all(mix.flavours.map((f) => getEntry(f)))).filter((e) => e !== undefined)
  : [];
// An even split to start, any remainder on the first flavour.
const mixStart = mixFlavours.map((_, i) =>
  mix ? Math.floor(mix.cans / mixFlavours.length) + (i === 0 ? mix.cans % mixFlavours.length : 0) : 0,
);
const mixOption = !isPack && mixPack ? mixPack.data.packs[0] : undefined;
// What an order starts from: the page's first orderable pack, else the Mixed Pack.
const ownOrderable = data.packs.filter((pack) => pack.orderable !== false);
const startsMixed = isPack || (ownOrderable.length === 0 && !!mixOption);
const orderPack = startsMixed && !isPack ? mixOption! : (ownOrderable[0] ?? firstPack);
const startMix = mixFlavours.map((f, i) => ({ flavour: f.id, count: mixStart[i] }));
const notOrderable = data.packs.some((pack) => pack.orderable === false);
const otherPacks = range.filter(
  (p) => p.data.kind === "pack" && p.id !== id && p.id !== mixPack?.id,
);
const { reviews, average } = await getReviews(id);

const ICONS = {
  sprout: Sprout,
  flask: FlaskConical,
  palette: Palette,
  candy: Candy,
  "map-pin": MapPin,
} as const;
const promises = BENEFITS.filter((b) => b.confirmed).slice(0, 4);

const label = "text-[0.8125rem] leading-5 font-semibold text-ink-heading";
const pill =
  "inline-flex h-11 items-center rounded-full px-5 text-[0.875rem] font-medium ring-1 lg:fine:h-10 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-moss";
const pillIdle =
  "bg-white text-ink-heading ring-brand-leaf/14 hover:ring-brand-leaf/45";
const pillOn = "bg-brand-moss text-white ring-brand-moss";
const stepper =
  "grid size-11 place-items-center rounded-full text-ink-heading lg:fine:size-9 ring-1 ring-brand-leaf/14 transition-colors hover:bg-brand-moss hover:text-white hover:ring-brand-moss focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-moss";
---

<div class="font-inter text-ink-heading lg:pt-2">
  <p class="text-[0.75rem] leading-4 font-bold tracking-[0.1625rem] text-brand-fern uppercase">
    {data.brand}
  </p>
  <h1 class="mt-3 font-display text-[clamp(2.5rem,5.6vw,3.75rem)] leading-[1] font-bold tracking-[-0.8px] text-balance">
    {data.name}
  </h1>
  <p
    class:list={[
      "mt-3 font-display text-[clamp(1.125rem,2vw,1.3125rem)] leading-snug italic",
      tint.onLight,
    ]}
  >
    {data.tagline}
  </p>

  {reviews.length > 0 && (
    <a
      href="#reviews-heading"
      class="mt-3 inline-flex items-center gap-2 rounded-sm text-[0.8125rem] text-ink-body/75 transition-colors hover:text-brand-moss focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-moss"
    >
      <span
        class="flex gap-0.5"
        role="img"
        aria-label={`${average.toFixed(1)} out of 5 stars`}
      >
        {Array.from({ length: 5 }, (_, i) => (
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            class:list={[
              "size-4",
              i < Math.round(average)
                ? "fill-brand-gold"
                : "fill-brand-leaf/12",
            ]}
          >
            <path d={STAR_PATH} />
          </svg>
        ))}
      </span>
    {/* {reviews.length} {reviews.length === 1 ? "review" : "reviews"}*/}
    </a>
  )}

  <p class="mt-5 max-w-md text-[1rem] leading-[1.65] text-ink-body">
    {data.summary}
  </p>

  {!isPack && (
    <div class="mt-7">
      <p class={label}>Flavour</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        {flavours.map((f) => (
          <li>
            <a
              href={productHref(f.id)}
              aria-current={f.id === id ? "page" : undefined}
              class:list={[pill, f.id === id ? pillOn : pillIdle]}
            >
              {f.data.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}

  <fieldset data-pack-select class="mt-6">
    <legend class={label}>Pack options</legend>
    <div class="mt-3 flex flex-wrap gap-2">
      {data.packs.map((pack, i) => (
        <label
          class:list={[
            pill,
            pillIdle,
            "relative cursor-pointer has-checked:bg-brand-moss has-checked:text-white has-checked:ring-brand-moss has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-brand-moss has-disabled:cursor-not-allowed has-disabled:opacity-45 has-disabled:hover:ring-brand-leaf/14",
          ]}
        >
          <input
            type="radio"
            name="pack"
            value={pack.id}
            checked={!startsMixed ? pack === orderPack : isPack && i === 0}
            disabled={pack.orderable === false}
            data-detail={pack.detail ?? ""}
            class="sr-only"
          />
          {pack.label}
          {pack.detail && pack.detail !== pack.label && (
            <span class="ml-1.5 opacity-70">{pack.detail}</span>
          )}
        </label>
      ))}
      {mixOption && mixPack && (
        <label
          class:list={[
            pill,
            pillIdle,
            "relative cursor-pointer has-checked:bg-brand-moss has-checked:text-white has-checked:ring-brand-moss has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-brand-moss",
          ]}
        >
          <input
            type="radio"
            name="pack"
            value={mixOption.id}
            checked={startsMixed}
            data-detail={mixOption.detail ?? ""}
            data-mix
            data-product={mixPack.id}
            class="sr-only"
          />
          {mixOption.label}
          {mixOption.detail && (
            <span class="ml-1.5 opacity-70">{mixOption.detail}</span>
          )}
        </label>
      )}
      {otherPacks.map((p) => (
        <a href={productHref(p.id)} class:list={[pill, pillIdle]}>
          {p.data.name}
        </a>
      ))}
    </div>
    {notOrderable && (
      <p class="mt-2.5 text-[0.75rem] leading-5 text-ink-body/65">
        Single cans are sold in stores. Orders come in packs of 6.
      </p>
    )}
  </fieldset>

  {mix && mixFlavours.length > 0 && (
    <div
      data-mix-builder
      data-cans={mix.cans}
      data-product={id}
      hidden={!startsMixed}
      class="mt-4 max-w-md rounded-[1.25rem] bg-white p-5 ring-1 ring-brand-leaf/10"
    >
      <div class="flex items-baseline justify-between gap-3">
        <p class={label}>Build your pack</p>
        <p
          data-mix-status
          role="status"
          tabindex="-1"
          class="text-[0.8125rem] font-medium text-ink-body/75 tabular-nums"
        >
          {mix.cans} of {mix.cans} cans
        </p>
      </div>
      <ul class="mt-3 flex flex-col divide-y divide-brand-leaf/8">
        {mixFlavours.map((f, i) => (
          <li data-mix-row data-flavour={f.id} class="flex items-center gap-3 py-2.5">
            <span
              aria-hidden="true"
              class:list={["size-2 shrink-0 rounded-full", tintOf(f.id).dot]}
            />
            <span class="text-[0.875rem] text-ink-heading">{f.data.name}</span>
            <div class="ml-auto flex items-center gap-2">
              <button
                type="button"
                data-mix-step="-1"
                aria-label={`One fewer ${f.data.name}`}
                class:list={[stepper, "size-11 lg:fine:size-8 disabled:pointer-events-none disabled:opacity-35"]}
              >
                <Minus class="size-3.5" stroke-width={2} aria-hidden="true" />
              </button>
              <output
                data-mix-count
                aria-label={`${f.data.name} cans`}
                class="w-6 text-center text-[0.9375rem] font-semibold tabular-nums"
              >
                {mixStart[i]}
              </output>
              <button
                type="button"
                data-mix-step="1"
                aria-label={`One more ${f.data.name}`}
                class:list={[stepper, "size-11 lg:fine:size-8 disabled:pointer-events-none disabled:opacity-35"]}
              >
                <Plus class="size-3.5" stroke-width={2} aria-hidden="true" />
              </button>
            </div>
          </li>
        ))}
      </ul>
      <p class="mt-2 text-[0.75rem] leading-5 text-ink-body/65">
        Any {mix.cans} cans, in any mix. Your mix is sent with your enquiry.
      </p>
    </div>
  )}

  <div class="mt-6 flex items-center gap-4">
    <label for="product-quantity" class={label}>
      Quantity
    </label>
    <div data-quantity class="flex items-center gap-2">
      <button
        type="button"
        data-quantity-step="-1"
        aria-label="One fewer"
        class={stepper}
      >
        <Minus class="size-4" stroke-width={2} aria-hidden="true" />
      </button>
      <input
        id="product-quantity"
        type="number"
        inputmode="numeric"
        min="1"
        max="99999"
        step="1"
        value="1"
        class="h-11 w-14 rounded-full bg-white text-center text-[1rem] font-semibold tabular-nums lg:fine:h-9 lg:text-[0.9375rem] ring-1 ring-brand-leaf/14 [appearance:textfield] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-moss [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
      />
      <button
        type="button"
        data-quantity-step="1"
        aria-label="One more"
        class={stepper}
      >
        <Plus class="size-4" stroke-width={2} aria-hidden="true" />
      </button>
    </div>
  </div>

  <div class="mt-7 grid gap-3 sm:grid-cols-2">
    <PillLink
      href={inquiryHref({ intent: "store", product: id })}
      class="h-[3.25rem] px-8 text-[0.9375rem]"
    >
      Find in Store
    </PillLink>
    <a
      href={inquiryHref({
        intent: startsMixed ? "mixed" : "bulk",
        product: startsMixed ? mixPack?.id : id,
        pack: orderPack.id,
        mix: startsMixed ? startMix : undefined,
      })}
      data-inquiry="order"
      class="inline-flex h-[3.25rem] aria-disabled:cursor-not-allowed aria-disabled:opacity-45 aria-disabled:hover:bg-white aria-disabled:hover:text-brand-moss items-center justify-center rounded-full bg-white px-8 text-[0.9375rem] font-semibold text-brand-moss ring-1 ring-brand-moss/40 transition-colors hover:bg-brand-moss hover:text-white hover:ring-brand-moss focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-brand-moss"
    >
      Order Now
    </a>
  </div>

  <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.875rem] text-ink-body tabular-nums">
    <span data-pack-detail>{orderPack.detail ?? data.size}</span>
    <span aria-hidden="true" class="text-ink-body/35">
      &middot;
    </span>
    <span>Sparkling</span>
    <span aria-hidden="true" class="text-ink-body/35">
      &middot;
    </span>
    <span>
      {data.facts.shelfLife.replace(/^(\d+)\s+Months?$/i, "$1-month")} shelf
      life
    </span>
  </p>

  <ul
    class="mt-6 grid grid-cols-2 gap-y-5 border-y border-brand-leaf/10 py-5 sm:grid-cols-4 sm:divide-x sm:divide-brand-leaf/10"
    aria-label="In every can"
  >
    {promises.map(({ icon, title }) => {
      const Icon = ICONS[icon];
      return (
        <li class="flex flex-col items-center gap-2 px-2 text-center text-[0.75rem] leading-4 text-ink-body">
          <Icon
            class="size-6 text-brand-moss"
            stroke-width={1.6}
            aria-hidden="true"
          />
          {title}
        </li>
      );
    })}
  </ul>

  <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
    {RETAILERS.length > 0 && (
      <a
        href={inquiryHref({ intent: "store", product: id })}
        class="-my-2.5 flex flex-wrap items-center gap-x-3 gap-y-2 rounded-md py-2.5 text-[0.8125rem] font-semibold text-ink-heading lg:fine:my-0 lg:fine:py-0 transition-colors hover:text-brand-moss focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-brand-moss"
      >
        Available at
        {RETAILERS.map((r) => (
          <span class="opacity-80">
            <StoreLogo retailer={r} size="sm" />
          </span>
        ))}
      </a>
    )}
    <div class="flex items-center gap-3">
      <span
        data-share-status
        role="status"
        class="text-[0.8125rem] text-brand-moss"
      ></span>
      <button
        type="button"
        data-share
        data-share-title={`${data.brand} ${data.name}`}
        class="inline-flex h-11 items-center gap-2 rounded-full px-3 text-[0.875rem] lg:fine:h-9 lg:fine:px-1 font-medium text-ink-body transition-colors hover:text-brand-moss focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-moss"
      >
        <Share2 class="size-4" stroke-width={1.8} aria-hidden="true" />
        Share
      </button>
    </div>
  </div>
</div>
