---
import FlavourCard from "./FlavourCard.astro";
import { getRange } from "./range";

/**
 * "You may also like": the rest of the range as the listing's cards. Three
 * across from `md`; below that a swipeable shelf with the next card peeking in.
 */
interface Props {
  productId: string;
}

const { productId } = Astro.props;
const others = (await getRange()).filter((p) => p.id !== productId);
---

<section
  aria-labelledby="related-heading"
  class="bg-brand-ivory pb-16 font-inter lg:pb-20"
>
  <div class="mx-auto max-w-[1200px] md:px-10">
    <h2
      id="related-heading"
      data-reveal
      class="px-5 font-display text-[clamp(28px,3.6vw,36px)] leading-[1.1] font-bold tracking-[-0.4px] text-ink-heading md:px-0"
    >
      You may also like
    </h2>
    <ul class="mt-7 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto overscroll-x-contain px-5 pt-1 pb-6 scrollbar-none md:grid md:grid-cols-3 md:gap-6 md:overflow-visible md:px-0 md:pb-0">
      {others.map((product) => (
        <li
          data-reveal
          class="flex-[0_0_min(78%,320px)] snap-start md:flex-auto"
        >
          <FlavourCard product={product} />
        </li>
      ))}
    </ul>
  </div>
</section>
