---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import PackSpecs from "./PackSpecs.astro";
import ProductFacts from "./ProductFacts.astro";
import ChevronIcon from "./icons/ChevronIcon.astro";

/**
 * "Choose your Flavor": one can on a stage between two pieces of corner
 * artwork per flavour, with the pack claims under it. Everything is static
 * HTML; `scripts/anim/carousel.ts` drives the change and the shared canvas
 * draws the can into `[data-view="carousel"]`.
 */
interface Props {
  heading?: string;
}

const { heading = "Choose your Flavor" } = Astro.props;

// The flavours only: packs have no can of their own to put on the stage.
const flavours = (await getCollection("flavours"))
  .map((entry) => entry.data)
  .flatMap(({ key, background, ...rest }) => (key && background ? [{ ...rest, key, background }] : []))
  .sort((a, b) => a.order - b.order);
const first = flavours[0];

// Two voices: a letterspaced sans eyebrow over one big display word — the last
// word of the heading.
const headingWords = heading.trim().split(/\s+/);
const displayWord = headingWords.at(-1) ?? "";
const eyebrow = headingWords.slice(0, -1).join(" ");

// What the client script needs to swap a flavour in, and nothing more.
const clientData = JSON.stringify(
  flavours.map(({ key, name, facts }) => ({ key, name, extract: facts.extract })),
);

/**
 * One size, `--can`, drives the can, the gold ring and the halo, so they stay
 * locked together. The three terms are the three ways the stage runs out of
 * room: the design size on a roomy screen, the height the heading and claims
 * leave free, and a narrow phone with both arrows beside it. A phone on its
 * side has no height to give, so there the section grows past one screen
 * and the can takes most of a screen's height instead. A short laptop
 * window (`squat:`) trims the padding and heading and may grow past one
 * screen rather than clip the claims; a large monitor caps the can at 46rem
 * so it stays in proportion with the type.
 *
 * The arrows are 44px at the smallest: they are thumb targets.
 */
const ARROW_BUTTON =
  "grid size-11 shrink-0 place-items-center rounded-full bg-white/90 text-neutral-700 shadow-[0_6px_20px_-6px_rgba(28,26,23,0.35)] ring-brand-gold backdrop-blur-xs transition hover:bg-white hover:text-brand-ink focus:outline-hidden focus-visible:ring-2 sm:size-12 md:size-14 lg:size-16";

/**
 * Phones (portrait): the section is as tall as its content (no spare
 * screen to open gaps around the stage), and the arrows ride over the
 * stage's edges instead of flanking it, so the can gets the column's full
 * width. The stage may run a
 * little past the column on both sides (`unsafe` centring: plain `center`
 * would let it overflow to the right only), into the side padding, which only
 * the halo and ring reach. The arrows sit on the column's edges.
 */
const ARROW_OVERLAY =
  "max-sm:portrait:absolute max-sm:portrait:top-1/2 max-sm:portrait:z-10 max-sm:portrait:-translate-y-1/2";
---

<section
  id="products"
  aria-labelledby="products-heading"
  data-flavours={clientData}
  class="carousel relative isolate grid h-svh min-h-[34rem] touch-pan-y grid-rows-[auto_4fr_auto] justify-center overflow-hidden bg-brand-ivory px-4 py-8 text-brand-ink [--can:min(80vmin,calc(100svh_-_20rem),calc(100vw_-_8.5rem),46rem)] sm:py-12 squat:h-auto! squat:min-h-svh! squat:py-6! squat:[--can:min(80vmin,calc(100svh_-_18rem),calc(100vw_-_8.5rem))] sm:portrait:h-auto! sm:portrait:min-h-0! sm:portrait:py-16! sm:portrait:[--stage-top:calc(4rem+4.25rem)] md:portrait:[--stage-top:calc(4rem+6rem)] lg:portrait:[--stage-top:calc(4rem+7.5rem)] short:h-auto! short:min-h-svh! short:gap-y-3 short:py-6! short:[--can:min(72svh,20rem)] max-sm:portrait:h-auto max-sm:portrait:min-h-0 max-sm:portrait:gap-y-2 max-sm:portrait:[--stage-top:calc(84px+13vw)] max-sm:portrait:grid-cols-[100%] max-sm:portrait:justify-items-center max-sm:portrait:[--can:min(calc(100vw_+_2rem),calc(100svh_-_19rem))]"
>
  {/*
    Each flavour's backdrop is a pair of corner pieces. On a change the pair
    breaks apart to its own edges while the incoming one slides in from both
    sides. A piece keeps its size at every breakpoint; the smaller the screen,
    the further past the edge it sits. The wrapper is absolute so it stays
    out of the section's grid rows. On a portrait screen (phones, upright
    tablets) a half-width piece shows as a sliver, or as a small strip
    floating mid-height, so there each piece runs from the section's top to
    the bottom of the flavour name instead, uncropped (the box shrink-wraps
    the image at its own ratio). That is the stage's top (`--stage-top`:
    padding, eyebrow, the 13vw heading and its 24px gap), the stage
    (`--can`), and the 8px gap and 32px name under it; the claims below
    stay clear. The art is cut off at its outer edges (the mango at the left
    one's bottom, the leaf at the right one's top), so this height puts
    those cuts at the top of the section and at the name, not mid-screen,
    and each cut edge is masked out into the ground so it doesn't end on a
    hard line. Upright tablets set their own `--stage-top` (their padding
    and heading sizes) and drop the full-screen height, as phones do. The
    pieces are
    wider than the room beside the can, so they run off the screen's sides,
    with their inner edges stopping at 36vw / 64vw, just inside the can's
    sides, so the art's inner edge tucks a little behind the can (the canvas
    draws over the page) without covering the label. `-z-10` inside the section's own stacking context
    (`isolate`) keeps the art under every other layer of the section (ring,
    arrows and copy included) while still over its ground. In portrait the
    halo drops under it too (`-z-20`), so it doesn't wash out the fruit.
  */}
  {
    flavours.map(({ background }, i) => (
      <div aria-hidden="true" class="absolute inset-0 -z-10">
        <div
          data-side="left"
          data-index={i}
          class:list={[
            "flavor-piece pointer-events-none absolute inset-y-0 left-[-32%] w-1/2 select-none portrait:bottom-auto portrait:h-[calc(var(--stage-top)+var(--can)+2.5rem)] portrait:left-auto portrait:right-[64vw] portrait:w-auto sm:landscape:left-[-24%] md:landscape:left-[-12%] lg:landscape:left-0",
            i > 0 && "opacity-0 noscript:hidden",
          ]}
        >
          <Image
            src={background.left}
            alt=""
            widths={[320, 480, background.left.width]}
            sizes="(orientation: portrait) 100vw, 50vw"
            class="absolute inset-0 h-full w-full object-contain object-left portrait:static portrait:h-full portrait:w-auto portrait:max-w-none portrait:mask-b-from-94%"
          />
        </div>
        <div
          data-side="right"
          data-index={i}
          class:list={[
            "flavor-piece pointer-events-none absolute inset-y-0 right-[-32%] w-1/2 select-none portrait:bottom-auto portrait:h-[calc(var(--stage-top)+var(--can)+2.5rem)] portrait:right-auto portrait:left-[64vw] portrait:w-auto sm:landscape:right-[-24%] md:landscape:right-[-12%] lg:landscape:right-0",
            i > 0 && "opacity-0 noscript:hidden",
          ]}
        >
          <Image
            src={background.right}
            alt=""
            widths={[240, background.right.width]}
            sizes="(orientation: portrait) 100vw, 50vw"
            class="absolute inset-0 h-full w-full object-contain object-right portrait:static portrait:h-full portrait:w-auto portrait:max-w-none portrait:mask-t-from-95%"
          />
        </div>
      </div>
    ))
  }

  <h2 id="products-heading" data-reveal class="relative text-center">
    {/* The indent offsets the trailing letter-space so the line optically centres. */}
    {
      eyebrow && (
        <span class="block indent-[0.3em] text-[0.65rem] font-bold tracking-[0.3em] text-neutral-500 uppercase sm:indent-[0.42em] sm:text-xs sm:tracking-[0.42em] md:text-sm short:hidden">
          {eyebrow}
        </span>
      )
    }
    <span
      class="mt-1 block font-display text-[length:min(11.5vw,3.25rem)] leading-none font-semibold max-sm:portrait:text-[length:13vw] tracking-tight sm:text-5xl md:text-7xl lg:text-8xl squat:text-7xl! short:text-4xl!"
    >
      {displayWord}
    </span>
  </h2>

  <div class="relative grid grid-cols-[auto_auto_auto] items-center gap-2 max-sm:portrait:mt-6 max-sm:portrait:grid-cols-1 sm:gap-4 md:gap-6">
    <button type="button" data-flavor-prev class:list={[ARROW_BUTTON, ARROW_OVERLAY, "max-sm:portrait:left-0"]}>
      <ChevronIcon class="size-4 sm:size-5 md:size-6" />
      <span class="sr-only">Previous Flavor</span>
    </button>

    {/*
      The can's box. The halo and ring are anchored to it rather than to the
      section, so the circle tracks the can at every size.
    */}
    <div class="relative aspect-square h-[var(--can)] min-h-32 max-sm:portrait:[justify-self:unsafe_center]" data-flavor-stage>
      {/* Warm halo, lifting the can off the ivory ground. */}
      <div
        aria-hidden="true"
        class="pointer-events-none absolute top-[62%] left-1/2 aspect-square w-[115%] -translate-x-1/2 -translate-y-1/2 rounded-full portrait:-z-20 bg-[radial-gradient(circle,#fdf6e6_0%,#faf2e4_45%,transparent_70%)]"
      >
      </div>

      {/* Thin gold ring, broken top and bottom. */}
      <svg
        aria-hidden="true"
        viewBox="0 0 200 200"
        class="pointer-events-none absolute top-[62%] left-1/2 aspect-square w-[82%] -translate-x-1/2 -translate-y-1/2 text-brand-gold"
      >
        <circle
          cx="100"
          cy="100"
          r="98"
          fill="none"
          stroke="currentColor"
          stroke-width="0.6"
          stroke-opacity="0.85"
          stroke-linecap="round"
          pathLength="100"
          stroke-dasharray="34 16"
          stroke-dashoffset="17"></circle>
      </svg>

      <div data-view="carousel" data-flavor={first.key} aria-hidden="true" class="absolute inset-0">
      </div>

      {/*
        Net contents and shelf life, one on each shoulder of the can. Below
        `md` those corners are too tight; the pair moves under the claims.
      */}
      <PackSpecs
        volume={first.facts.volume}
        shelfLife={first.facts.shelfLife}
        layout="flank"
        class="hidden md:flex short:hidden!"
      />
    </div>

    <button type="button" data-flavor-next class:list={[ARROW_BUTTON, ARROW_OVERLAY, "max-sm:portrait:right-0"]}>
      <ChevronIcon class="size-4 -scale-x-100 sm:size-5 md:size-6" />
      <span class="sr-only">Next Flavor</span>
    </button>
  </div>

  <div class="text-area relative mx-auto max-w-full text-center">
    <div
      class="text-wrapper text-2xl font-medium text-balance sm:text-3xl md:text-4xl short:text-2xl!"
      aria-live="polite"
    >
      <p data-flavor-name>{first.name}</p>
    </div>
  </div>

  {/*
    Phones (portrait): the four claims, then the two specs centred under
    them, as quarter-width stacked badges — both lists dissolve into one
    wrapping row (`contents`). Everywhere
    else the wrapper is `contents` itself, so the lists sit in the section's
    grid exactly as before.
  */}
  <div
    class="contents max-md:portrait:relative max-md:portrait:-mx-2 max-md:portrait:mt-8 max-md:portrait:flex max-md:portrait:w-auto max-md:portrait:flex-wrap max-md:portrait:items-start max-md:portrait:justify-center max-md:portrait:gap-y-7 max-md:portrait:[&_li]:basis-1/4"
  >
    <ProductFacts
      extract={first.facts.extract}
      class="relative mx-auto mt-4 w-full max-w-xl md:max-w-2xl max-md:portrait:contents"
    />

    <PackSpecs
      volume={first.facts.volume}
      shelfLife={first.facts.shelfLife}
      class="relative mt-3 md:hidden max-md:portrait:contents short:flex!"
    />
  </div>

  {/*
    The whole range, in text. The carousel only ever shows one flavour, so
    without this a screen reader — or a crawler — would only meet the first.
  */}
  <div class="sr-only">
    <h3>The Thynkers Lyquid range</h3>
    <ul>
      {
        flavours.map((flavour) => (
          <li>
            <strong>{flavour.name}</strong>: {flavour.description} {flavour.facts.volume}, shelf
            life {flavour.facts.shelfLife}.
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { runCarousel } from "../scripts/anim/carousel";
  runCarousel();
</script>
