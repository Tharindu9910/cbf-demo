---
import type { ImageMetadata } from "astro";

import { placeholderFor } from "./placeholder";

/**
 * A blurred stand-in for a large photo ("blur-up"), painted with the first
 * HTML: a 24px-wide WebP inlined as a data URI (~0.5 kB, no extra request),
 * stretched and blurred to the photo's box. Put it just before the photo
 * with the same positioning classes, inside a parent that clips (the blur
 * is scaled up so its soft edges fall outside). The photo fades in on top
 * once it has loaded (`scripts/anim/imageLoading.ts`).
 *
 * Built from the source file at build time. Astro keeps that path on the
 * image's metadata as the non-enumerable `fsPath`; without it (a remote
 * image, a future Astro), nothing renders and the photo simply fades in.
 */
interface Props {
  src: ImageMetadata;
  class?: string;
}

const { src, class: className } = Astro.props;
const path = (src as ImageMetadata & { fsPath?: string }).fsPath;
const dataUri = path ? await placeholderFor(path) : undefined;
---

{
  dataUri && (
    <img
      src={dataUri}
      alt=""
      aria-hidden="true"
      data-placeholder
      class:list={["pointer-events-none scale-125 blur-2xl select-none", className]}
    />
  )
}
