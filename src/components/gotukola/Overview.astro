---
import Cite from "./Cite.astro";
import SectionHeading from "../about/SectionHeading.astro";
import { GOTUKOLA } from "../../config/gotukola";

/**
 * Screen one: the herb in brief. Copy and the dishes as chips on the left, the
 * fact card on the right from `lg`, then a four-number strip of its
 * distinctive compounds and minerals. Type, spacing and cards follow About's
 * "Our Story" and Values.
 */
const { eyebrow, title, body, dishes, dishesLabel, facts, factsCite, stats } = GOTUKOLA.overview;
---

<section id="overview" aria-labelledby="overview-heading" class="scroll-mt-24 bg-brand-ivory py-20 lg:py-28">
  <div class="mx-auto max-w-page px-5 md:px-10">
    <div class="grid gap-12 font-inter lg:grid-cols-[minmax(0,11fr)_minmax(0,9fr)] lg:gap-16">
      <div data-reveal>
        <SectionHeading id="overview-heading" eyebrow={eyebrow} title={title} />
        <p class="mt-5 text-[1rem] leading-[1.5625rem] text-ink-body">{body}</p>

        <p class="mt-6 text-[0.75rem] leading-4 font-bold tracking-[0.1625rem] text-brand-fern uppercase">{dishesLabel}</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {
            dishes.map((d) => (
              <li class="rounded-full bg-brand-sage px-4 py-1.5 text-[0.8125rem] leading-5 font-medium text-brand-pine">{d}</li>
            ))
          }
        </ul>
      </div>

      <div data-reveal class="self-start">
        <dl class="divide-y divide-brand-moss/15 rounded-[1.25rem] bg-white/85 px-6 py-2 shadow-[0_10px_30px_-20px_rgb(30_50_20/0.35)] sm:px-8">
          {
            facts.map(({ label, value }) => (
              <div class="grid gap-1 py-3.5 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:gap-4">
                <dt class="text-[0.8125rem] leading-5 font-medium text-brand-fern">{label}</dt>
                <dd class:list={["text-[0.875rem] leading-5 font-medium text-ink-heading", label === "Botanical name" && "italic"]}>
                  {value}
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-2 text-[0.75rem] text-ink-body/70">Source <Cite ids={factsCite} /></p>
      </div>
    </div>

    <dl data-reveal class="mt-16 grid grid-cols-2 gap-x-6 gap-y-8 font-inter lg:mt-20 lg:grid-cols-4">
      {
        stats.map((s) => (
          <div class="flex flex-col border-t-2 border-brand-moss/30 pt-5">
            <dt class="text-[0.8125rem] leading-5 text-ink-body">
              {s.label}
              <Cite ids={[s.cite]} class="text-brand-fern" />
            </dt>
            <dd class="order-first mb-2 font-display text-[clamp(1.75rem,4vw,2.375rem)] leading-none font-bold text-ink-heading">
              {s.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
