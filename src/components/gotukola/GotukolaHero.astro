---
import { Image } from "astro:assets";

import heroPhoto from "../../assets/images/gotu-kola/gotukola-leaves-hero.jpg";
import { GOTUKOLA } from "../../config/gotukola";

/**
 * The Gotukola page's opening: a close-up of gotukola leaves, darkened for
 * the white header and the copy. Eyebrow, the page's only <h1> one sentence per
 * line, the intro, then the herb's names in four languages.
 */
const { eyebrow, title, intro, names } = GOTUKOLA.hero;
const titleLines = title.split(/(?<=\.)\s+/);
---

<section
  aria-labelledby="gotukola-hero-heading"
  class="relative isolate flex min-h-[max(520px,62svh)] overflow-hidden bg-brand-leaf text-white"
>
  <Image
    src={heroPhoto}
    alt="Overhead view of a dense bed of fresh, round gotukola leaves with water droplets"
    widths={[768, 1280, 1376]}
    sizes="100vw"
    quality={80}
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-20 h-full w-full object-cover"
  />
  {/* Darkens the top for the header, the left for the copy and the bottom for the names. */}
  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgb(6_22_14/0.75)_0%,rgb(6_22_14/0.45)_50%,rgb(6_22_14/0.1)_85%),linear-gradient(to_bottom,rgb(6_22_14/0.55)_0%,rgb(6_22_14/0.05)_30%,rgb(6_22_14/0.6)_100%)]"
  >
  </div>

  <div class="relative flex w-full flex-col justify-end px-5 pt-32 pb-12 md:px-10 md:pb-12 lg:pr-10 lg:pl-[11vw]">
    <p class="font-poppins text-[11px] leading-4 font-medium tracking-[4px] text-brand-green uppercase md:text-[12px]">
      {eyebrow}
    </p>
    <h1
      id="gotukola-hero-heading"
      class="mt-4 max-w-[14ch] font-display text-[clamp(40px,5vw,76px)] leading-[1.02] font-bold tracking-[-0.5px] drop-shadow-[0_2px_24px_rgb(0_0_0/0.3)]"
    >
      {titleLines.map((line) => <span class="block">{line}</span>)}
    </h1>
    <p class="mt-5 max-w-[34em] font-poppins text-[15px] leading-[1.6] text-white/90 md:text-[clamp(16px,1.2vw,19px)]">
      {intro}
    </p>
    <dl class="mt-8 grid max-w-[920px] grid-cols-2 gap-x-6 gap-y-5 border-t border-white/20 pt-6 font-poppins md:grid-cols-4">
      {
        names.map(({ lang, name }) => (
          <div class="flex flex-col">
            <dt class="text-[10px] leading-4 font-medium tracking-[2.5px] text-white/60 uppercase">{lang}</dt>
            <dd class:list={["mt-1 text-[15px] leading-snug font-medium md:text-[16px]", lang === "Botanical" && "italic"]}>
              {name}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
