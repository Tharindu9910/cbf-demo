---
import Cite from "./Cite.astro";
import SectionHeading from "../about/SectionHeading.astro";
import { EVIDENCE_BADGE } from "./icons";
import { EVIDENCE_LABELS, GOTUKOLA, SOURCE_IDS } from "../../config/gotukola";

/**
 * Screen two: what the research says, one row per topic with its evidence
 * badge, then safety, a one-line disclaimer and the numbered Sources every
 * citation on the page links to (`#source-<n>`). Set in About's type, on
 * the pale green band its Values use.
 */
const { eyebrow, title, findings, note, safety, disclaimer } = GOTUKOLA.evidence;
const { sources } = GOTUKOLA;
---

<section id="evidence" aria-labelledby="evidence-heading" class="bg-gotukola-band py-20 lg:py-24">
  <div class="mx-auto max-w-page px-5 font-inter md:px-10">
    <SectionHeading id="evidence-heading" eyebrow={eyebrow} title={title} data-reveal />

    <ul class="mt-10 grid lg:mt-12 gap-x-10 gap-y-1 md:grid-cols-2">
      {
        findings.map((f) => (
          <li data-reveal class="flex flex-col gap-2 border-t border-brand-moss/20 py-4">
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2">
              <h3 class="text-[1.0625rem] leading-6 font-semibold text-ink-heading">{f.topic}</h3>
              <p class:list={["rounded-full px-3 py-1 text-[0.75rem] leading-4 font-semibold", EVIDENCE_BADGE[f.evidence]]}>
                <span class="sr-only">Evidence: </span>
                {EVIDENCE_LABELS[f.evidence]}
              </p>
            </div>
            <p class="text-[0.875rem] leading-[1.6] text-ink-body">
              {f.body}
              <Cite ids={f.cite} class="text-brand-fern" />
            </p>
          </li>
        ))
      }
    </ul>

    <p data-reveal class="mt-4 max-w-3xl border-l-[3px] border-brand-pine py-0.5 pl-6 text-[1rem] leading-[1.5625rem] font-semibold text-ink-heading">
      {note}
    </p>

    <div data-reveal class="mt-10 rounded-[1.25rem] bg-white/85 px-6 py-8 shadow-[0_10px_30px_-20px_rgb(30_50_20/0.35)] sm:px-8">
      <h3 class="text-[1.1875rem] leading-6 font-semibold text-ink-heading">{safety.title}</h3>
      <p class="mt-3 text-[0.9375rem] leading-[1.6] text-ink-body">
        {safety.body}
        <Cite ids={safety.cite} class="text-brand-fern" />
      </p>
      <p class="mt-3 text-[0.75rem] leading-5 font-medium text-ink-body/80">{disclaimer}</p>
    </div>

    <div class="mt-12">
      <h3 class="text-[0.75rem] leading-4 font-bold tracking-[0.1625rem] text-brand-fern uppercase">Sources</h3>
      <ol class="mt-4 grid gap-x-10 gap-y-3 text-[0.75rem] md:gap-y-2 leading-[1.5] text-ink-body md:grid-cols-2">
        {
          SOURCE_IDS.map((id, i) => (
            <li id={`source-${i + 1}`} class="grid scroll-mt-8 grid-cols-[2em_1fr] target:text-ink-heading">
              <span class="font-semibold text-brand-fern">{i + 1}.</span>
              <a
                href={sources[id].href}
                target="_blank"
                rel="noopener noreferrer"
                class="-my-1.5 py-1.5 underline decoration-brand-moss/30 underline-offset-2 hover:decoration-brand-moss focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-moss"
              >
                {sources[id].label}
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
