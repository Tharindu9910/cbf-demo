---
import { Image, Picture } from "astro:assets";

import BrandIntro from "./BrandIntro.astro";
import ArrowDownIcon from "./icons/ArrowDownIcon.astro";
import ArrowRightIcon from "./icons/ArrowRightIcon.astro";
import LeafIcon from "./icons/LeafIcon.astro";
import RecycleIcon from "./icons/RecycleIcon.astro";
import SealIcon from "./icons/SealIcon.astro";

import heroBg1 from "../assets/images/hero/hero-bg-1.jpg";
import heroBg2 from "../assets/images/hero/hero-bg-2.jpg";
import heroBg4 from "../assets/images/hero/hero-bg-4.jpg";
import heroBg5 from "../assets/images/hero/hero-bg-5.jpg";
import heroBg6 from "../assets/images/hero/hero-bg-6.jpg";
import heroBg8 from "../assets/images/hero/hero-bg-8.jpg";
import brandIntroBg from "../assets/images/hero/brand-intro-bg.png";
// import cansTrio from "../assets/images/cans-trio.png"; // top can slot is commented out below
import { url } from "../config/url";

/**
 * The background slideshow, in order. Add an image here and the loop in
 * `scripts/anim/heroSlideshow.ts` picks it up at the same cadence.
 */
const HERO_BACKGROUNDS = [heroBg1, heroBg2, heroBg4, heroBg5, heroBg6, heroBg8];

/**
 * Responsive widths up to the photo's own width, topped out at 3840. The
 * steps above 1920 matter: without them a retina laptop, which wants ~3300px
 * for these cropped full-bleed slides, jumped straight to a 5–6k original.
 */
const MAX_WIDTH = 3840;
const widthsFor = (width: number) => [
  ...[640, 960, 1280, 1672, 1920, 2560, 3200].filter((w) => w < width),
  Math.min(width, MAX_WIDTH),
];

const HERO_FEATURES = [
  { Icon: LeafIcon, title: "Real Ingredients", body: "Only the best from nature" },
  {
    Icon: RecycleIcon,
    title: "Sustainably Crafted",
    body: "Better for you, better for our planet",
  },
  { Icon: SealIcon, title: "Proudly Ceylon", body: "Made in Sri Lanka with care" },
];
---

{/*
  `overflow-x-clip`: the headline's entrance scales each word up from 3x, and
  on a phone that briefly overflows the screen and zooms the whole page out.
  `clip` rather than `hidden`, because `hidden` would make this a scroll
  container and break the sticky 3D layer inside it.
*/}
<section class="hero group/hero overflow-x-clip px-4 first:pt-10 md:px-6" aria-labelledby="hero-heading">
  {/*
    The photo layer sits outside `.hero-fade`, so it paints straight away as
    the page's largest image instead of waiting for the entrance under an
    opacity of 0. Fixed, so where it sits in the DOM changes nothing on screen.
  */}
  <div class="hero-bg pointer-events-none fixed inset-0 z-0">
    {/*
      The slides stack; the GSAP loop cross-fades between them. Only the first
      is high priority — it's the LCP image. No `scale-*` classes: GSAP owns the
      transform on these. The rest start `hidden`: they sit in the viewport, so
      `loading="lazy"` alone would still fetch them all at once, against the
      first paint. The slideshow shows them once the page has loaded, long
      before the first hand-over (and never, for reduced motion or no script).
    */}
    {
      HERO_BACKGROUNDS.map((src, i) => (
        <Picture
          src={src}
          alt=""
          formats={["webp"]}
          widths={widthsFor(src.width)}
          sizes="100vw"
          quality={78}
          loading={i === 0 ? "eager" : "lazy"}
          fetchpriority={i === 0 ? "high" : "auto"}
          class:list={["hero-bg-slide absolute inset-0 h-full w-full object-cover", i > 0 && "hidden"]}
        />
      ))
    }

    {/*
      Three stacked shades: a flat knock-down of the photo's brightness, a
      top/bottom gradient so the headline and the cue clear the sky and the
      horizon, and a soft pool of black behind the centred copy. `z-10` is
      load-bearing: the cross-fade lifts the incoming slide to z-index 1.
    */}
    <div class="absolute inset-0 z-10 bg-black/20"></div>
    <div class="absolute inset-0 z-10 bg-linear-to-b from-black/30 via-black/10 to-black/35"></div>
    <div class="absolute inset-0 z-10 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.45)_0%,transparent_70%)]"></div>
  </div>

  {/* `Bounded`'s centred column; hidden until the entrance sets it visible (at once without script). */}
  <div class="hero-fade mx-auto flex w-full max-w-7xl flex-col items-center opacity-0 noscript:opacity-100!">
    {/*
      The shared canvas draws the hero cans into this box. Portrait screens
      size it to the small viewport, so the address bar can't stretch the
      frame the cans are laid out in.
    */}
    <div
      data-view="hero"
      aria-hidden="true"
      class="hero-scene pointer-events-none sticky top-0 z-50 -mt-[100vh] h-screen w-screen portrait:-mt-[100svh] portrait:h-svh portrait:w-full"
    >
    </div>

    {/* w-full so the runway below is a real two-column grid. */}
    <div class="relative z-10 grid w-full">
      {/*
        The first screen. Landscape centres the copy in exactly one screen,
        between the cans; portrait stacks the cans' slot over the copy from
        the top, and lets the screen grow if a short phone needs it. Desktop
        (`lg:landscape:`) centres it in the screen below the nav instead, and
        grows past one screen rather than overflow on a short window.
      */}
      <div
        class="grid min-h-svh grid-cols-[minmax(0,1fr)] justify-items-center portrait:content-center portrait:pt-24 portrait:pb-12 sm:portrait:pt-28 landscape:h-screen landscape:place-items-center lg:landscape:h-auto lg:landscape:min-h-screen lg:landscape:pt-32 lg:landscape:pb-8 short:h-auto! short:pt-24! short:pb-10!"
      >
        {/* `minmax(0,1fr)`: a wide line can't stretch the column off centre. */}
        <div class="grid w-full grid-cols-[minmax(0,1fr)] auto-rows-min place-items-center text-center">
          {/*
            Portrait: the 3D cans stood in this slot, above the headline. Hidden
            for now, so the first phone screen is the copy alone. Without the
            slot the scene skips straight to the rise into the "end" slot.

          <div data-can-slot="top" class="relative mb-5 hidden h-[30svh] w-full portrait:block">
            <Image
              src={cansTrio}
              alt="Three cans of Thynkers Lyquid: Mango Passion, Pineapple and Matcha Original"
              widths={[320, 640, 960]}
              sizes="(orientation: portrait) 30vh, 1px"
              loading="eager"
              class="absolute inset-0 mx-auto h-full w-auto object-contain transition-opacity duration-500 group-data-[hero-3d]/hero:opacity-0"
            />
          </div>
          */}

          {/*
            Every size here must be an arbitrary value: Tailwind's named sizes
            ship their own line-height, which would override leading-[.82].
          */}
          <h1
            id="hero-heading"
            class="hero-header relative font-aonic text-[length:min(4.5rem,calc((100vw_-_2rem)/6))] leading-[.82] font-black text-white uppercase drop-shadow-[0_8px_34px_rgba(0,0,0,0.45)] sm:text-[4.5rem] md:text-[6.5rem] lg:landscape:text-[length:min(7.2vw,14vh)] short:text-[2.75rem]!"
          >
            <span class="hero-header-word block">Ceylon</span>
            <span class="hero-header-word block">Future</span>
            {/*
              The G sits in its own inline-block (it once anchored a leaf
              sprite). That breaks the kerning either side of it, and the
              headline's width depends on it — keep it.
            */}
            <span class="hero-header-word block whitespace-nowrap">Bevera<span class="relative inline-block">G</span>es</span>
          </h1>

          <p
            class="hero-subheading mt-5 font-ubuntu text-lg font-semibold text-white drop-shadow-[0_2px_14px_rgba(0,0,0,0.5)] min-[400px]:text-xl md:mt-6 md:text-2xl lg:text-[1.75rem] lg:leading-8 short:mt-3! short:text-base!"
          >
            Crafted for tomorrow. Inspired by nature.
          </p>

          <p
            class="hero-body mt-3 max-w-xl text-sm leading-relaxed text-balance text-white/80 md:mt-4 md:text-base md:leading-6 lg:text-lg lg:leading-7 short:hidden"
          >
            Refreshing sparkling beverages made with real ingredients, sustainably crafted in Sri
            Lanka for a better future.
          </p>

          {/*
            Phones keep the pills compact and side by side, so the headline
            stays the loudest thing on the first screen; full size from `sm`.
          */}
          <div
            class="hero-ctas mt-7 flex flex-wrap items-center justify-center gap-3 sm:gap-4 md:mt-8 lg:landscape:mt-7 short:mt-5!"
          >
            <a
              href={url("/products/")}
              class="hero-cta inline-flex h-11 items-center justify-center gap-2 rounded-full px-5 font-inter text-sm font-semibold sm:h-[3.25rem] sm:gap-2.5 sm:px-8 sm:text-[0.9375rem] tracking-[0.1px] btn-glow focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white lg:h-[3.375rem]"
            >
              Shop Products
              <ArrowRightIcon class="size-3.5 sm:size-4" />
            </a>
            <a
              href={url("/about/")}
              class="hero-cta inline-flex h-11 items-center justify-center rounded-full border border-white/60 bg-white/10 px-5 font-inter text-sm font-semibold sm:h-[3.25rem] sm:px-8 sm:text-[0.9375rem] tracking-[0.1px] text-white backdrop-blur-sm transition-colors hover:bg-white hover:text-ink-heading focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-white lg:h-[3.375rem]"
            >
              Our Story
            </a>
          </div>

          {/* Phones: one compact row of icon and title; the line under each joins from `sm`. */}
          <ul
            class="hero-features mt-10 grid w-full max-w-3xl grid-cols-3 divide-x divide-white/25 md:mt-12 lg:landscape:mt-8 short:hidden"
          >
            {
              HERO_FEATURES.map(({ Icon, title, body }) => (
                <li class="hero-feature flex flex-col items-center gap-2 px-2 text-center sm:flex-row sm:items-start sm:justify-center sm:gap-3 sm:px-5 sm:text-left">
                  <Icon class="mt-0.5 h-6 w-6 shrink-0 text-white sm:h-7 sm:w-7" />
                  <div>
                    <p class="text-xs leading-snug font-semibold text-white sm:text-sm sm:leading-5">{title}</p>
                    <p class="hidden text-xs leading-snug text-white/70 sm:block">{body}</p>
                  </div>
                </li>
              ))
            }
          </ul>

          <a
            href="#scroll"
            class="hero-scroll-cue mt-8 inline-flex items-center gap-4 text-sm text-white/80 transition-colors hover:text-white md:mt-12 lg:landscape:mt-6 short:hidden"
          >
            Scroll to explore
            <span class="grid h-11 w-11 place-items-center rounded-full border border-white/40 md:h-10 md:w-10">
              <ArrowDownIcon class="h-4 w-4" />
            </span>
          </a>
        </div>
      </div>

      {/*
        Second screen: the scroll runway for the can choreography. Landscape:
        the cans assemble in the right half of the frame, so the copy takes
        the left. Portrait: the copy, then the slot the cans settle into.
      */}
      <div
        id="scroll"
        class="text-side relative z-[80] grid min-h-svh w-full content-start gap-4 pt-20 portrait:gap-6 portrait:pb-16 max-sm:portrait:flex max-sm:portrait:flex-col max-sm:portrait:gap-[2svh] max-sm:portrait:pt-[4svh] max-sm:portrait:pb-16 landscape:min-h-screen landscape:content-normal landscape:items-center landscape:py-24 md:landscape:grid-cols-2 md:landscape:py-28 squat:py-12!"
      >
        {/*
          The runway owns its ground. It breaks out of the centred column to
          the full viewport width (`left-1/2 w-screen -translate-x-1/2`); the
          flat cream underneath is the photo's own, so whatever `object-cover`
          crops reads as more cream.
        */}
        <div
          class="pointer-events-none absolute top-0 left-1/2 h-full w-screen -translate-x-1/2 overflow-hidden bg-hero-runway"
        >
          <Image
            src={brandIntroBg}
            alt=""
            widths={widthsFor(brandIntroBg.width)}
            sizes="100vw"
            quality={78}
            class="h-full w-full object-cover"
          />
        </div>

        <div class="relative">
          <BrandIntro class="brand-intro" id="about" />
        </div>

        {/*
          Portrait: where the cans come to rest, under the copy. The runway's
          `portrait:pb-16` keeps floor under it: the sticky scene lets go at
          the runway's bottom, and without it the cans' shadows fall off the
          canvas. Phones: the slot grows into whatever the copy leaves, but
          never under half a screen, so the cans stay a readable size on a
          short phone (the runway then runs a little past one screen).
        */}
        <div data-can-slot="end" aria-hidden="true" class="hidden h-[38svh] w-full portrait:block tablet-p:h-[42svh] max-sm:portrait:h-auto max-sm:portrait:min-h-[50svh] max-sm:portrait:flex-1"></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { runHeroIntro } from "../scripts/anim/heroIntro";
  import { runHeroSlideshow } from "../scripts/anim/heroSlideshow";

  runHeroSlideshow();
  runHeroIntro();
</script>
