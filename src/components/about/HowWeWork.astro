---
import { Image } from "astro:assets";
import ArrowRight from "@lucide/astro/icons/arrow-right";

import { ICONS, type IconName } from "./icons";
import { ABOUT } from "../../config/about";
import { heading } from "../../styles/section";

/**
 * "How We Work": source to delivery in four numbered steps, after the
 * mockup. Four across from `lg` with an arrow between each photo, two on
 * tablets, one on phones. Each step has its number in green beside its name,
 * with the line below aligned under the name. A step without a photo shows
 * its icon on deep green in the photo's place.
 */
const { eyebrow, title, steps } = ABOUT.howWeWork;
const titleLines = title.split(/(?<=\.)\s+/);
---

<section aria-labelledby="how-heading" class="bg-brand-ivory py-20 lg:py-24">
  <div class="mx-auto max-w-[1200px] px-5 md:px-10">
    <div data-reveal class="font-inter">
      <p class="text-[12px] leading-4 font-bold tracking-[2.6px] uppercase text-brand-fern">{eyebrow}</p>
      <h2
        id="how-heading"
        class:list={[heading, "mt-3 text-ink-heading lg:text-[44px]"]}
      >
        {titleLines.map((line) => <span class="block">{line}</span>)}
      </h2>
    </div>

    <ol class="mt-10 grid gap-x-8 gap-y-12 font-inter sm:grid-cols-2 lg:mt-12 lg:grid-cols-4 lg:gap-x-16">
      {
        steps.map((step, i) => {
          const Icon = ICONS[step.icon as IconName];
          const number = String(i + 1).padStart(2, "0");
          const last = i === steps.length - 1;
          return (
            <li data-reveal class="flex flex-col">
              <div class="relative">
                {step.image ? (
                  <Image
                    src={step.image.src}
                    alt={step.image.alt}
                    widths={[320, 560, 800]}
                    sizes="(min-width: 1024px) 240px, (min-width: 640px) 45vw, 100vw"
                    quality={80}
                    loading="lazy"
                    class="aspect-[10/7] w-full rounded-[14px] object-cover shadow-[0_12px_28px_-18px_rgb(13_43_18/0.45)]"
                  />
                ) : (
                  <div
                    class="grid aspect-[10/7] w-full place-items-center rounded-[14px] bg-brand-leaf text-brand-green"
                    aria-hidden="true"
                  >
                    <Icon class="size-12" stroke-width={1.4} />
                  </div>
                )}
                {!last && (
                  <ArrowRight
                    aria-hidden="true"
                    class="absolute top-1/2 -right-8 hidden size-6 translate-x-1/2 -translate-y-1/2 text-brand-pine lg:block"
                    stroke-width={1.75}
                  />
                )}
              </div>
              <div class="mt-5 grid grid-cols-[auto_1fr] items-baseline gap-x-4">
                <span class="text-[19px] leading-6 font-semibold text-brand-fern">{number}</span>
                <h3 class="text-[17px] leading-6 font-semibold text-ink-heading">{step.title}</h3>
                <p class="col-start-2 mt-3 max-w-[20ch] text-[14px] leading-[1.6] text-ink-body">{step.body}</p>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
