---
import { Image } from "astro:assets";

import SectionHeading from "./SectionHeading.astro";
import { ABOUT } from "../../config/about";
import worldMap from "../../assets/images/about/quality-world-map.jpg";

/**
 * "Quality": trust for consumers and export buyers. The copy sits on the left
 * over the world map's dark side, the export routes out of Sri Lanka on the
 * right. The certification cards list only what `config/about.ts` marks as
 * held, each with its logo when one is supplied, otherwise a text badge. With
 * none confirmed, the section stands on its copy alone.
 */
const { eyebrow, title, intro, certifications } = ABOUT.quality;
const held = certifications.filter((c) => c.held);
---

<section
  aria-labelledby="quality-heading"
  class="relative isolate overflow-hidden bg-brand-leaf py-20 text-white lg:py-28"
>
  <Image
    src={worldMap}
    alt=""
    widths={[640, 1024, 1600, 2400, 3200]}
    sizes="100vw"
    quality={80}
    loading="lazy"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[72%_center] lg:object-center"
  />
  {/* Narrower screens crop the map in behind the copy: darken it there. */}
  <div aria-hidden="true" class="absolute inset-0 -z-10 bg-black/55 lg:hidden"></div>

  <div class="mx-auto max-w-[1200px] px-5 md:px-10">
    <div data-reveal class="max-w-xl font-inter">
      <SectionHeading id="quality-heading" eyebrow={eyebrow} title={title} tone="light" />
      <p class="mt-6 text-[16px] leading-[25px] text-white/80">{intro}</p>

      {
        held.length > 0 && (
          <ul class="mt-10 grid gap-4 sm:grid-cols-2">
            {held.map((cert) => (
              <li class="flex items-start gap-4 rounded-[18px] border border-white/15 bg-white/[0.04] p-5">
                {cert.logo ? (
                  <Image
                    src={cert.logo.src}
                    alt={cert.logo.alt}
                    height={48}
                    densities={[1, 2]}
                    loading="lazy"
                    class="h-12 w-auto shrink-0 rounded-md bg-white p-1"
                  />
                ) : (
                  <span class="grid h-12 min-w-12 shrink-0 place-items-center rounded-full border border-brand-green/60 px-2 text-[12px] font-bold tracking-[1px] text-brand-green">
                    {cert.code}
                  </span>
                )}
                <p class="text-[14px] leading-[1.5] text-white/80">
                  <strong class="block text-[15px] text-white">{cert.code}</strong>
                  {cert.label}
                </p>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</section>
