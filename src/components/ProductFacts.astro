---
import Boxes from "@lucide/astro/icons/boxes";
import Candy from "@lucide/astro/icons/candy";
import FlaskConical from "@lucide/astro/icons/flask-conical";
import Leaf from "@lucide/astro/icons/leaf";
import Palette from "@lucide/astro/icons/palette";

import Claim from "./Claim.astro";

/**
 * The pack's claims — four icons and their copy, shared by the whole range.
 * Only the extract under the first one is per-product, and it carries the
 * `flavor-swap` hook so the carousel fades it in step with the name.
 *
 * One row of four from `md` up, spread edge to edge so the outer two sit flush
 * with the specs hung off the can's shoulders; 2x2 on phones.
 */
interface Props {
  extract: string;
  class?: string;
}
const { extract, class: className } = Astro.props;
---

<ul
  class:list={[
    "grid grid-cols-2 gap-x-5 gap-y-3 text-brand-ink md:flex md:justify-between md:gap-x-4",
    className,
  ]}
>
  <Claim icon={Leaf} headline="100% Natural" note={extract} swaps />
  <Claim icon={Palette} headline="No" plus note="Artificial Colors" />
  <Claim icon={FlaskConical} headline="No" plus note="Preservatives" />
  <Claim icon={Candy} mobileIcon={Boxes} headline="Low" note="Sugar" />
</ul>
