---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import ImageIcon from "@lucide/astro/icons/image";
import Pause from "@lucide/astro/icons/pause";
import Play from "@lucide/astro/icons/play";
import Volume2 from "@lucide/astro/icons/volume-2";
import VolumeX from "@lucide/astro/icons/volume-x";

import PillLink from "./ui/PillLink.astro";
import { SOCIAL_LINKS } from "../config/site";
import { body, eyebrow, phoneBody, phoneEyebrow, phoneFont, phoneHeading } from "../styles/section";

/**
 * "Caught Mid-Sip": the wall of customers' own videos, photos and comments
 * between the flavour carousel and Order Now, built from
 * `content/reactions`. Pills above it filter the wall by kind.
 *
 * From `lg` up it reproduces the 1536px mockup: every length is the frame's
 * px times `--u` (`lg:frame-1536`; text has floors). The wall is a wrapping
 * flex row, each tile's grow factor its mockup width, so the two rows of the
 * mockup come out exactly and a filtered wall still fills its rows. Below `lg`
 * it is a two-column grid: videos and comments span both columns, photos pair
 * up (the first photo spans both when there is an odd number).
 *
 * A video plays in place once its clip is in the content entry, links out to
 * `href` until then, and otherwise shows its still with the play mark.
 *
 * TODO: the comments are samples (`placeholder: true`) and the handles are the
 * mockup's. Swap in the real posters' handles and consented quotes before
 * launch, and add each video's clip (`video`) or post link (`href`).
 */

const reactions = (await getCollection("reactions"))
  .map((entry) => entry.data)
  .sort((a, b) => a.order - b.order);

/** The handle the CTA asks people to tag; the footer's Instagram link wins once it is set. */
const INSTAGRAM_HANDLE = "ceylonfuturebeverages";
const instagramHref =
  SOCIAL_LINKS.find((link) => link.icon === "instagram")?.href ||
  `https://www.instagram.com/${INSTAGRAM_HANDLE}/`;

/** The flavour chip: a short label on the can's colour. */
const CHIP: Record<string, { label: string; class: string }> = {
  "matcha-original": { label: "Matcha", class: "bg-flavour-matcha" },
  "mango-passion": { label: "Mango & Passion", class: "bg-flavour-mango" },
  pineapple: { label: "Pineapple", class: "bg-flavour-pineapple-deep" },
};

/**
 * Each tile's place on the `lg` wall, in order: grow by its mockup width,
 * start from 90% of it (so a row of the mockup fits and the next tile wraps),
 * and the mockup row's height. `width` sizes the image request; `centerPlay`
 * is the wide video, whose play mark sits in the middle.
 */
const SLOTS = [
  {
    width: 480,
    class:
      "lg:grow-480 lg:basis-[calc(432*var(--u))] lg:min-h-[calc(332*var(--u))]",
  },
  {
    width: 310,
    class:
      "lg:grow-310 lg:basis-[calc(279*var(--u))] lg:min-h-[calc(332*var(--u))]",
  },
  {
    width: 598,
    class:
      "lg:grow-598 lg:basis-[calc(538*var(--u))] lg:min-h-[calc(332*var(--u))]",
    centerPlay: true,
  },
  {
    width: 432,
    class:
      "lg:grow-432 lg:basis-[calc(389*var(--u))] lg:min-h-[calc(316*var(--u))]",
  },
  {
    width: 340,
    class:
      "lg:grow-340 lg:basis-[calc(306*var(--u))] lg:min-h-[calc(316*var(--u))]",
  },
  {
    width: 310,
    class:
      "lg:grow-310 lg:basis-[calc(279*var(--u))] lg:min-h-[calc(316*var(--u))]",
  },
  {
    width: 292,
    class:
      "lg:grow-292 lg:basis-[calc(263*var(--u))] lg:min-h-[calc(316*var(--u))]",
  },
];
const EXTRA_SLOT = {
  width: 360,
  class:
    "lg:grow-360 lg:basis-[calc(324*var(--u))] lg:min-h-[calc(316*var(--u))]",
};

/** Below `lg` photos pair up; with an odd count the first one spans the row. */
const photos = reactions.filter((r) => r.kind === "photo");
const widePhoto = photos.length % 2 === 1 ? photos[0] : undefined;

const FOCUS = {
  center: "object-center",
  top: "object-[50%_22%]",
  bottom: "object-bottom",
};

const FILTERS = [
  { id: "all", label: "All" },
  { id: "video", label: "Videos" },
  { id: "photo", label: "Photos" },
  { id: "comment", label: "Comments" },
];

/*
 * The entrance, armed by the script below: tiles rise one after another until
 * `is-in` lands. (Written out in full: Tailwind only sees verbatim class names.)
 */
const entrance =
  "in-[.is-armed]:transition-[opacity,translate] in-[.is-armed]:duration-800 in-[.is-armed]:ease-rise in-[.is-armed]:nth-2:delay-70 in-[.is-armed]:nth-3:delay-140 in-[.is-armed]:nth-4:delay-210 in-[.is-armed]:nth-5:delay-280 in-[.is-armed]:nth-6:delay-350 in-[.is-armed]:nth-7:delay-420 in-[.is-armed:not(.is-in)]:translate-y-7 in-[.is-armed:not(.is-in)]:opacity-0";

const chip =
  "inline-flex h-7 shrink-0 items-center rounded-full px-3 text-[12px] font-semibold whitespace-nowrap text-white shadow-[0_2px_6px_rgb(0_0_0/0.12)] lg:h-[max(24px,calc(30*var(--u)))] lg:px-[calc(14*var(--u))] lg:text-[length:max(11px,calc(13*var(--u)))]";

/** A round play mark with a white ring, the video tiles' main control. */
const playMark =
  "grid size-12 shrink-0 place-items-center rounded-full border-2 border-white/90 bg-black/25 text-white backdrop-blur-[2px] transition-[background-color,scale] duration-300 hover:bg-black/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white lg:size-[max(40px,calc(50*var(--u)))]";
const playMarkIcon =
  "size-5 translate-x-px fill-current lg:size-[max(16px,calc(20*var(--u)))]";

const muteMark =
  "absolute right-2 bottom-2 grid size-11 place-items-center text-white/90 lg:right-[calc(16*var(--u))] lg:bottom-[calc(16*var(--u))] lg:size-[max(26px,calc(30*var(--u)))]";
const muteIcon = "size-5 lg:size-[max(16px,calc(20*var(--u)))]";

/** A bold, rounded "66", drawn so it sits the same in every face. */
const QUOTE_MARK =
  "M0 18C0 9.5 4.5 3.6 10.5.8L12 3C8.6 4.8 6.6 8 6.2 12A6 6 0 1 1 0 18Zm15 0c0-8.5 4.5-14.4 10.5-17.2L27 3c-3.4 1.8-5.4 5-5.8 9a6 6 0 1 1-6.2 6Z";

const initials = (name: string) =>
  name
    .split(/\s+/)
    .map((word) => word[0])
    .join("")
    .toUpperCase();
---

<section
  id="reviews"
  aria-labelledby="reviews-heading"
  class:list={[
    "@container relative isolate overflow-hidden bg-brand-ivory font-inter text-ink-heading",
    phoneFont,
  ]}
  data-reactions
>
  {/* Soft green shapes in three corners, as in the mockup. */}


  <div class="mx-auto max-w-[680px] px-5 py-16 lg:frame-1536 lg:max-w-[1536px] lg:px-[calc(60*var(--u))] lg:pt-[calc(58*var(--u))] lg:pb-[calc(50*var(--u))]">
    <header class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between lg:gap-[calc(40*var(--u))]">
      <div class="lg:pl-[calc(16*var(--u))]">
        <p class:list={[eyebrow, "text-brand-fern", phoneEyebrow]}>REAL PEOPLE, REAL SIPS</p>
        <h2
          id="reviews-heading"
          class:list={[
            phoneHeading,
            "mt-3 font-display text-[length:clamp(44px,12vw,60px)] leading-none font-bold tracking-[-0.5px] text-ink-heading lg:mt-[calc(10*var(--u))] lg:ml-[calc(-3*var(--u))] lg:text-[length:max(52px,calc(72*var(--u)))] lg:tracking-[calc(-0.8*var(--u))]",
          ]}
        >
          Caught <span class="whitespace-nowrap">Mid-Sip.</span>
        </h2>
        <p
          class:list={[body, phoneBody, "mt-4 text-ink-body lg:mt-[calc(14*var(--u))]"]}
        >
          Real reactions from people drinking our products.
        </p>
      </div>

      {/* Below lg the pills scroll sideways if they ever outgrow the row. */}
      {/*<div
        role="group"
        aria-label="Filter reactions"
        class="-mx-5 flex gap-2 overflow-x-auto px-5 scrollbar-none lg:mx-0 lg:mt-[calc(33*var(--u))] lg:shrink-0 lg:gap-[calc(11*var(--u))] lg:overflow-visible lg:px-0"
      >
        {FILTERS.map((filter) => (
          <button
            type="button"
            data-filter={filter.id}
            aria-pressed={filter.id === "all" ? "true" : "false"}
            class="h-10 shrink-0 rounded-full border border-gk-ring bg-white/40 px-5 text-[13px] font-medium whitespace-nowrap text-ink-body/70 transition-colors duration-200 hover:border-brand-moss/50 hover:text-brand-moss focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-moss aria-pressed:border-brand-moss aria-pressed:bg-brand-moss aria-pressed:shadow-pill aria-pressed:font-semibold aria-pressed:text-white lg:h-[max(36px,calc(42*var(--u)))] lg:min-w-[calc(78*var(--u))] lg:px-[calc(25*var(--u))] lg:text-[length:max(12px,calc(14*var(--u)))]"
          >
            {filter.label}
          </button>
        ))}
      </div>*/}
    </header>

    <ul class="mt-8 grid grid-cols-2 gap-3 sm:gap-4 lg:mt-[calc(25*var(--u))] lg:flex lg:flex-wrap lg:gap-[calc(16*var(--u))]">
      {reactions.map((item, i) => {
        const slot = SLOTS[i] ?? EXTRA_SLOT;
        const flavourChip = CHIP[item.flavour.id] ?? {
          label: item.flavour.id,
          class: "bg-flavour-matcha",
        };
        const wide = item === widePhoto;
        const sizes = `(min-width: 1536px) ${slot.width}px, (min-width: 1024px) ${(slot.width / 15.36).toFixed(1)}vw, ${
          item.kind === "photo" && !wide
            ? "min(50vw, 330px)"
            : "min(100vw, 680px)"
        }`;

        return (
          <li
            data-kind={item.kind}
            data-reaction
            class:list={[
              "group/card relative min-w-0",
              slot.class,
              item.kind === "video" && "col-span-2 max-lg:aspect-[3/2]",
              item.kind === "photo" &&
                (wide
                  ? "col-span-2 max-lg:aspect-[5/4]"
                  : "max-lg:aspect-[4/5]"),
              item.kind === "comment" && "col-span-2",
              entrance,
            ]}
          >
            {item.kind === "comment" ? (
              <figure class="relative flex h-full flex-col overflow-hidden rounded-2xl bg-linear-to-br from-brand-cream to-gk-card-muted p-6 lg:rounded-[calc(14*var(--u))] lg:p-[calc(26*var(--u))] lg:pb-[calc(22*var(--u))]">
                {/* Two leaves tucked into the top-right corner. */}
                <svg
                  class="pointer-events-none absolute -top-1 -right-1 w-16 text-brand-green lg:-top-[calc(4*var(--u))] lg:-right-[calc(4*var(--u))] lg:w-[calc(70*var(--u))]"
                  viewBox="0 0 70 62"
                  aria-hidden="true"
                >
                  <path
                    fill="currentColor"
                    opacity="0.55"
                    d="M70 4C55 0 38 6 30 18c-6 9-6 19-2 26 12-1 24-8 32-19 5-7 8-14 10-21Z"
                  />
                  <path
                    fill="currentColor"
                    d="M58 26c-11 2-21 10-25 20-3 7-2 13 1 16 9-3 17-10 21-19 2-5 3-11 3-17Z"
                  />
                  <path
                    fill="none"
                    class="stroke-brand-cream"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    opacity="0.7"
                    d="M64 9C50 18 38 30 29 43M55 31C47 39 40 49 35 59"
                  />
                </svg>

                <svg
                  class="w-9 fill-brand-moss lg:w-[max(28px,calc(34*var(--u)))]"
                  viewBox="0 0 27 24"
                  aria-hidden="true"
                >
                  <path d={QUOTE_MARK} />
                </svg>

                <blockquote class="mt-4 font-display text-[23px] leading-[1.3] font-normal text-ink-heading lg:mt-[calc(14*var(--u))] lg:pr-[calc(6*var(--u))] lg:text-[length:max(17px,calc(25*var(--u)))] lg:leading-[1.3]">
                  <p class="-indent-[0.42em]">&ldquo;{item.quote}&rdquo;</p>
                </blockquote>

                <figcaption class="mt-6 border-t border-brand-moss/20 pt-4 lg:mt-[calc(20*var(--u))] lg:mb-[calc(12*var(--u))] lg:pt-[calc(16*var(--u))]">
                  <span class="flex items-center gap-3 lg:gap-[calc(12*var(--u))]">
                    <span
                      class="grid size-9 shrink-0 place-items-center rounded-full bg-brand-moss text-[13px] font-semibold tracking-[0.5px] text-white ring-2 ring-white/70 lg:size-[max(30px,calc(36*var(--u)))] lg:text-[length:max(11px,calc(13*var(--u)))]"
                      aria-hidden="true"
                    >
                      {initials(item.name)}
                    </span>
                    <span class="flex min-w-0 flex-col">
                      <span class="text-[15px] leading-5 font-semibold lg:text-[length:max(13px,calc(15*var(--u)))] lg:leading-[1.3]">
                        {item.name}
                      </span>
                      <span class="text-[13px] leading-[18px] text-ink-body/75 lg:text-[length:max(11px,calc(13*var(--u)))] lg:leading-[1.35]">
                        {item.handle}
                      </span>
                    </span>
                  </span>
                </figcaption>

              
              </figure>
            ) : (
              <figure class="absolute inset-0 overflow-hidden rounded-2xl bg-gk-card-muted lg:rounded-[calc(14*var(--u))]">
                <Image
                  src={item.image}
                  alt={item.alt}
                  widths={[400, 640, 900, 1200]}
                  sizes={sizes}
                  quality={80}
                  loading="lazy"
                  class:list={[
                    "absolute inset-0 size-full object-cover transition-transform duration-700 ease-rise select-none group-hover/card:scale-[1.035]",
                    FOCUS[item.focus],
                  ]}
                />

                {item.kind === "video" && item.video && (
                  <video
                    src={item.video}
                    class="absolute inset-0 size-full object-cover"
                    preload="none"
                    muted
                    loop
                    playsinline
                    hidden
                    aria-label={item.alt}
                    data-video
                  />
                )}

                {/* Darkens the foot of the tile so the handle reads on any photo. */}
                <span
                  class="pointer-events-none absolute inset-x-0 bottom-0 h-3/5 bg-linear-to-t from-black/60 via-black/20 to-transparent"
                  aria-hidden="true"
                />

                {item.kind === "photo" && item.href && (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener"
                    class="absolute inset-0 rounded-[inherit] focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-white"
                    aria-label={`See ${item.handle}'s post on Instagram`}
                  />
                )}

            

                <figcaption
                  class:list={[
                    "absolute bottom-4 left-4 flex items-center text-white lg:bottom-[calc(18*var(--u))] lg:left-[calc(18*var(--u))]",
                    item.kind === "video"
                      ? "gap-3 lg:gap-[calc(12*var(--u))]"
                      : "gap-2.5 lg:gap-[calc(12*var(--u))] lg:left-[calc(22*var(--u))] lg:bottom-[calc(20*var(--u))]",
                  ]}
                >
                  {item.kind === "photo" ? (
                    <ImageIcon
                      class="size-[18px] shrink-0 lg:size-[max(15px,calc(18*var(--u)))]"
                      stroke-width={1.75}
                      aria-hidden="true"
                    />
                  ) : (
                    !slot.centerPlay &&
                    (item.video ? (
                      <button
                        type="button"
                        class={playMark}
                        aria-label={`Play ${item.handle}'s video`}
                        data-play
                      >
                        <Play
                          class:list={[
                            playMarkIcon,
                            "group-data-[playing]/card:hidden",
                          ]}
                          aria-hidden="true"
                        />
                        <Pause
                          class:list={[
                            playMarkIcon,
                            "hidden translate-x-0 group-data-[playing]/card:block",
                          ]}
                          aria-hidden="true"
                        />
                      </button>
                    ) : item.href ? (
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener"
                        class={playMark}
                        aria-label={`Watch ${item.handle}'s video on Instagram`}
                      >
                        <Play class={playMarkIcon} aria-hidden="true" />
                      </a>
                    ) : (
                      <span class={playMark} aria-hidden="true">
                        <Play class={playMarkIcon} />
                      </span>
                    ))
                  )}
                  <span class="flex min-w-0 flex-col">
                    <span class="truncate text-[14px] leading-5 font-semibold [text-shadow:0_1px_3px_rgb(0_0_0/0.35)] lg:text-[length:max(12px,calc(15*var(--u)))] lg:leading-[1.3]">
                      {item.handle}
                    </span>
                    {item.kind === "video" && (
                      <span class="text-[12px] leading-4 text-white/80 lg:text-[length:max(11px,calc(12.5*var(--u)))] lg:leading-[1.35]">
                        Video{item.duration && <> &middot; {item.duration}</>}
                      </span>
                    )}
                  </span>
                </figcaption>

                {item.kind === "video" && slot.centerPlay && (
                  <span class="absolute inset-0 grid place-items-center pointer-events-none [&>*]:pointer-events-auto">
                    {item.video ? (
                      <button
                        type="button"
                        class={playMark}
                        aria-label={`Play ${item.handle}'s video`}
                        data-play
                      >
                        <Play
                          class:list={[
                            playMarkIcon,
                            "group-data-[playing]/card:hidden",
                          ]}
                          aria-hidden="true"
                        />
                        <Pause
                          class:list={[
                            playMarkIcon,
                            "hidden translate-x-0 group-data-[playing]/card:block",
                          ]}
                          aria-hidden="true"
                        />
                      </button>
                    ) : item.href ? (
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener"
                        class={playMark}
                        aria-label={`Watch ${item.handle}'s video on Instagram`}
                      >
                        <Play class={playMarkIcon} aria-hidden="true" />
                      </a>
                    ) : (
                      <span class={playMark} aria-hidden="true">
                        <Play class={playMarkIcon} />
                      </span>
                    )}
                  </span>
                )}

                {item.kind === "video" &&
                  (item.video ? (
                    <button
                      type="button"
                      class={muteMark}
                      aria-label="Unmute"
                      data-mute
                    >
                      <VolumeX
                        class:list={[
                          muteIcon,
                          "group-data-[unmuted]/card:hidden",
                        ]}
                        aria-hidden="true"
                      />
                      <Volume2
                        class:list={[
                          muteIcon,
                          "hidden group-data-[unmuted]/card:block",
                        ]}
                        aria-hidden="true"
                      />
                    </button>
                  ) : (
                    <span class={muteMark} aria-hidden="true">
                      <VolumeX class={muteIcon} />
                    </span>
                  ))}
              </figure>
            )}
          </li>
        );
      })}
    </ul>

    <p class="sr-only" data-filter-status></p>

    {/*
      The call to share. From lg a three-column grid: the copy and button sit
      dead centre as one group, and the same rule-and-sprig ornament mirrors on
      either side, so the row balances on the page's axis. Below lg a centred stack.
    */}
    <div class="mt-12 flex flex-col items-center gap-5 text-center lg:mt-[calc(48*var(--u))] lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-center lg:gap-[calc(40*var(--u))] lg:text-left">
      {[false, true].map((mirrored) => (
        <span
          class:list={[
            "hidden items-center gap-[calc(20*var(--u))] lg:flex",
            mirrored ? "order-last flex-row-reverse" : "order-first",
          ]}
          aria-hidden="true"
        >
          <span
            class:list={[
              "h-px flex-1 from-transparent to-brand-moss/30",
              mirrored ? "bg-linear-to-l" : "bg-linear-to-r",
            ]}
          />
          <svg
            class:list={[
              "size-[max(22px,calc(28*var(--u)))] shrink-0 text-brand-moss",
              mirrored && "-scale-x-100",
            ]}
            viewBox="0 0 30 30"
          >
            <path
              fill="currentColor"
              d="M14 27C9 25 4 20 3 13 2 9 3 5 5 3c4 2 8 6 9 12 1 4 1 8 0 12Z"
            />
            <path
              fill="currentColor"
              d="M16 27c1-5 4-10 9-12 2-1 4-1 5-1-1 5-4 9-8 11-2 1-4 2-6 2Z"
            />
            <path
              fill="none"
              class="stroke-brand-ivory"
              stroke-width="1"
              stroke-linecap="round"
              d="M5 4c3 6 6 13 9 22"
            />
          </svg>
        </span>
      ))}

      <div class="flex flex-col items-center gap-5 lg:flex-row lg:gap-[calc(32*var(--u))]">
        <div class="flex flex-col items-center lg:items-start">
          <p class:list={[eyebrow, "text-brand-fern", phoneEyebrow]}>GOT A REACTION?</p>
          <p class="mt-2 font-display text-[19px] leading-[1.4] text-ink-heading lg:mt-[calc(6*var(--u))] lg:text-[length:max(16px,calc(20*var(--u)))] lg:leading-[1.3]">
            Tag <span class="whitespace-nowrap">@{INSTAGRAM_HANDLE}</span>
            <span class="whitespace-nowrap">
              <span class="font-inter text-[0.78em] text-ink-body max-lg:font-outfit">
                and use
              </span>{" "}
              #ThynkersReaction
            </span>
          </p>
        </div>

        <PillLink
          href={instagramHref}
          arrow
          class="h-12 shrink-0 gap-2 px-7 text-[15px] max-lg:font-outfit max-lg:font-medium lg:h-[max(42px,calc(50*var(--u)))] lg:gap-[calc(9*var(--u))] lg:px-[calc(28*var(--u))] lg:text-[length:max(13px,calc(15*var(--u)))]"
        >
          Share Yours
        </PillLink>
      </div>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>("[data-reactions]");

  if (section) {
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const items = [...section.querySelectorAll<HTMLElement>("[data-reaction]")];
    const buttons = [
      ...section.querySelectorAll<HTMLButtonElement>("[data-filter]"),
    ];
    const status = section.querySelector<HTMLElement>("[data-filter-status]");

    // The entrance: armed only with motion allowed and IntersectionObserver,
    // so otherwise the wall is simply there.
    if (!still && "IntersectionObserver" in window) {
      section.classList.add("is-armed");
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          io.disconnect();
          section.classList.add("is-in");
        },
        { threshold: 0.15 },
      );
      io.observe(section);
    }

    // The filter pills: show one kind (or all), and fade the shown tiles in.
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const kind = button.dataset.filter;
        for (const b of buttons)
          b.setAttribute("aria-pressed", String(b === button));

        let shown = 0;
        for (const item of items) {
          const match = kind === "all" || item.dataset.kind === kind;
          if (!match)
            item.querySelector<HTMLVideoElement>("[data-video]")?.pause();
          item.hidden = !match;
          if (!match) continue;
          if (!still) {
            item.animate(
              [
                { opacity: 0, transform: "translateY(12px)" },
                { opacity: 1, transform: "none" },
              ],
              {
                duration: 450,
                delay: shown * 50,
                easing: "cubic-bezier(0.22, 1, 0.36, 1)",
                fill: "backwards",
              },
            );
          }
          shown++;
        }
        if (status)
          status.textContent = `Showing ${shown} ${button.textContent?.trim().toLowerCase()}`;
      });
    }

    // Videos with a clip: play in place, one at a time, muted until asked.
    const playing = new Set<HTMLElement>();
    const stop = (item: HTMLElement) => {
      item.querySelector<HTMLVideoElement>("[data-video]")?.pause();
    };

    for (const item of items) {
      const video = item.querySelector<HTMLVideoElement>("[data-video]");
      if (!video) continue;
      const play = item.querySelector<HTMLButtonElement>("[data-play]");
      const mute = item.querySelector<HTMLButtonElement>("[data-mute]");
      const handle =
        play?.getAttribute("aria-label")?.replace(/^Play /, "") ?? "video";

      video.addEventListener("play", () => {
        for (const other of playing) if (other !== item) stop(other);
        playing.add(item);
        item.dataset.playing = "";
        play?.setAttribute("aria-label", `Pause ${handle}`);
      });
      video.addEventListener("pause", () => {
        playing.delete(item);
        delete item.dataset.playing;
        play?.setAttribute("aria-label", `Play ${handle}`);
      });

      play?.addEventListener("click", () => {
        video.hidden = false;
        if (video.paused) void video.play();
        else video.pause();
      });

      mute?.addEventListener("click", () => {
        video.muted = !video.muted;
        if (video.muted) delete item.dataset.unmuted;
        else item.dataset.unmuted = "";
        mute.setAttribute("aria-label", video.muted ? "Unmute" : "Mute");
        if (!video.muted && video.paused) {
          video.hidden = false;
          void video.play();
        }
      });
    }
  }
</script>
