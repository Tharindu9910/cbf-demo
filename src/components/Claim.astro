---
// Every Lucide icon component shares this one type.
import type Leaf from "@lucide/astro/icons/leaf";

/**
 * One pack claim or spec: a gold-ringed icon beside a bold headline and a
 * small note. A hairline gold glyph on ivory all but disappears at this size,
 * so the ring keeps the gold and the glyph is drawn in ink. Phones (portrait)
 * stack it as a badge: a larger, unfilled full-gold ring, a larger glyph,
 * and a plain "No" (the "+" drops).
 */
interface Props {
  icon: typeof Leaf;
  headline: string;
  note?: string;
  /** Renders the superscript "+" of the pack's "No⁺" lockup. */
  plus?: boolean;
  /** Marks the note as per-product copy, for the flavour-change timeline. */
  swaps?: boolean;
  /** Icon on the right, copy right-aligned — for the can's right shoulder. */
  mirrored?: boolean;
  /** A different glyph for the phone (portrait) badge, where one reads better. */
  mobileIcon?: typeof Leaf;
}

const { icon: Icon, headline, note, plus, swaps, mirrored, mobileIcon: MobileIcon } = Astro.props;
---

<li class:list={["flex items-center gap-2.5 max-md:portrait:flex-col max-md:portrait:gap-2 max-md:portrait:text-center", mirrored && "flex-row-reverse text-right"]}>
  <span
    aria-hidden="true"
    class="grid size-11 shrink-0 place-items-center rounded-full border-2 border-brand-gold/70 bg-brand-gold/10 text-brand-ink max-md:portrait:size-12 max-md:portrait:border-brand-gold max-md:portrait:bg-transparent"
  >
    <Icon class:list={["size-5 max-md:portrait:size-6", MobileIcon && "max-md:portrait:hidden"]} stroke-width={2} />
    {MobileIcon && <MobileIcon class="hidden size-6 max-md:portrait:block" stroke-width={2} />}
  </span>
  <span class="min-w-0 leading-tight">
    <span class="block text-sm font-semibold max-md:portrait:text-[13px] max-md:portrait:whitespace-nowrap">
      {headline}{plus && <sup class="text-[0.6em] max-md:portrait:hidden">+</sup>}
    </span>
    <span
      class:list={["block text-[0.7rem] text-neutral-500 max-md:portrait:mt-0.5 max-md:portrait:text-[10.5px] max-md:portrait:whitespace-nowrap", swaps && "flavor-swap"]}
      data-flavor-extract={swaps ? "" : undefined}
    >
      {note}
    </span>
  </span>
</li>
