---
import Base from "../../layouts/Base.astro";
import { CONTACT } from "../../config/contact";
import { url } from "../../config/url";

/**
 * Where `contact.php` sends a visitor whose browser posted the form without
 * script. With script the thank-you shows in place and this page isn't seen.
 * Not indexed, and left out of the sitemap (astro.config.mjs).
 */
---

<Base title="Thank you | Ceylon Future Beverages" description={CONTACT.form.success} noindex stage={false} structuredData={false}>
  <section class="grid min-h-[80svh] place-items-center bg-brand-leaf px-6 pt-32 pb-20 text-center text-brand-cream">
    <div>
      <h1 class="font-display text-[clamp(40px,8vw,72px)] leading-none font-bold">Thank you!</h1>
      <p class="mt-6 font-inter text-[18px] text-brand-cream/85">Our team will get back to you shortly.</p>
      <a
        href={url("/")}
        class="mt-10 inline-flex items-center gap-3 rounded-full border border-brand-cream/50 px-7 py-4 font-inter text-sm font-semibold transition-colors hover:bg-brand-cream hover:text-brand-leaf"
      >
        Back to home
      </a>
    </div>
  </section>
</Base>
