---
import { Font } from "astro:assets";

import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import Seo from "../components/seo/Seo.astro";
import { SITE } from "../config/site";
import { url } from "../config/url";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Share image (path from /public) and its alt text; defaults in `Seo`. */
  image?: string;
  imageAlt?: string;
  /** The schema.org type of this page in the JSON-LD (`AboutPage` etc.). */
  pageType?: string;
  /** Only the home page lists the range as Products in the JSON-LD. */
  products?: boolean;
  /** A product page's id in `content/flavours`: its Product and breadcrumb go in the JSON-LD. */
  product?: string;
  /** Pages without 3D (the 404) skip the WebGL stage entirely. */
  stage?: boolean;
  structuredData?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  image,
  imageAlt,
  pageType,
  products,
  product,
  stage = true,
  structuredData = true,
} = Astro.props;
---

<!doctype html>
<html
  lang={SITE.lang}
  class="scroll-pt-[84px] overflow-x-clip has-[dialog:modal]:overflow-hidden md:scroll-pt-0"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* The headline face and the body face are on screen at first paint. */}
    <Font cssVariable="--ff-aonic" preload />
    <Font cssVariable="--ff-alpino" preload />
    <Font cssVariable="--ff-saira" />
    <Font cssVariable="--ff-playfair" />
    <Font cssVariable="--ff-fraunces" />
    <Font cssVariable="--ff-outfit" />
    <Font cssVariable="--ff-inter" />
    <Font cssVariable="--ff-poppins" />

    {
      /*
        Desktop only: the hero copy waits on the cans, so start their assets
        alongside the three.js chunk instead of after it. The `crossorigin`
        modes match how three's loaders request them, or the preload is wasted.
      */
      stage && (
        <>
          <link
            rel="preload"
            href={url("/models/real_can_250ml.glb")}
            as="fetch"
            crossorigin="anonymous"
            media="(min-width: 768px)"
          />
          <link
            rel="preload"
            href={url("/hdr/lobby.hdr")}
            as="fetch"
            crossorigin="anonymous"
            media="(min-width: 768px)"
          />
          <link
            rel="preload"
            href={url("/labels/pineapple.webp")}
            as="image"
            crossorigin="anonymous"
            media="(min-width: 768px)"
          />
          <link
            rel="preload"
            href={url("/labels/mango-passion.webp")}
            as="image"
            crossorigin="anonymous"
            media="(min-width: 768px)"
          />
          <link
            rel="preload"
            href={url("/labels/matcha-original.webp")}
            as="image"
            crossorigin="anonymous"
            media="(min-width: 768px)"
          />
        </>
      )
    }

    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      noindex={noindex}
    />
    {structuredData && (
      <JsonLd
        title={title}
        description={description}
        image={image}
        pageType={pageType}
        products={products}
        product={product}
      />
    )}
  </head>

  <body class="overflow-x-clip bg-page">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[1100] focus:rounded-full focus:bg-white focus:px-5 focus:py-3 focus:text-sm focus:text-brand-leaf"
    >
      Skip to content
    </a>

    <Header />

    <main id="main">
      <slot />
      {
        /*
          The one WebGL canvas for the site; see scripts/three/stage.ts. The
          same box the R3F <Canvas> wrapper drew: fixed to the viewport,
          clear of the pointer, under the header (z-100) and above the page
          copy. `h-lvh`, the tallest the viewport gets, so a phone's address
          bar sliding in and out never resizes (and re-allocates) the canvas.
        */
        stage && (
          <div
            class="pointer-events-none fixed inset-x-0 top-0 z-30 h-lvh overflow-hidden *:block *:size-full"
            data-stage
            aria-hidden="true"
          ></div>
        )
      }
    </main>

    <Footer />

    <script>
      // The loading sheen on late photos (`[data-skeleton]`), and the scroll
      // reveals (`[data-reveal]`), on every page.
      import { skeletonImages } from "../scripts/anim/imageLoading";
      import { revealOnScroll } from "../scripts/anim/reveal";

      skeletonImages();
      void revealOnScroll();
    </script>

    {stage && <script>
      import { heroEntered } from "../scripts/bridge";

      // three.js and the scenes stay out of the critical path: one chunk,
      // never blocking first paint. Desktop fetches it at once — the hero
      // copy waits on its cans. Touch screens show the cans as a photo
      // first (the hero copy doesn't wait), so the chunk comes once the
      // page has loaded and the main thread is idle, leaving the LCP photo
      // and the hero's entrance uncontested. A scroll starts it sooner.
      //
      // Portrait screens with the hero hold it further, until the headline
      // (the page's LCP) has landed: their cans start below the frame and
      // only rise in on scroll, so there is nothing to show before then, and
      // three's ~1s of start-up on a phone CPU would otherwise land in the
      // middle of the entrance.
      let started = false;
      const load = () => {
        if (started) return;
        started = true;
        import("../scripts/three/boot").then(({ boot }) => boot());
      };

      if (
        matchMedia(
          "(min-width: 768px) and (pointer: fine) and (orientation: landscape)",
        ).matches
      ) {
        load();
      } else {
        const idle = () =>
          "requestIdleCallback" in window
            ? requestIdleCallback(load, { timeout: 1500 })
            : setTimeout(load, 300);
        const loaded = new Promise((r) =>
          document.readyState === "complete"
            ? r(undefined)
            : addEventListener("load", r, { once: true }),
        );
        const holdForHeadline =
          matchMedia("(orientation: portrait)").matches && document.querySelector(".hero");
        Promise.all([
          loaded,
          holdForHeadline
            ? Promise.race([heroEntered.promise, new Promise((r) => setTimeout(r, 4000))])
            : null,
        ]).then(idle);
        addEventListener("scroll", load, { once: true, passive: true });
      }
    </script>}
  </body>
</html>
