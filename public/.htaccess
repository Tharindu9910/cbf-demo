# ---------------------------------------------------------------------------
# Ceylon Future Beverages — Apache config for GoDaddy (cPanel) hosting.
# Upload with the rest of dist/ into public_html/. Every block is wrapped in
# <IfModule>, so a module the host lacks is skipped rather than breaking the
# site with a 500.
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---- HTTPS and one canonical host -----------------------------------------
# Everything goes to https://www. in a single 301. If the site should live on
# the bare domain instead, swap the two host rules (and set SITE_URL to match).
<IfModule mod_rewrite.c>
  RewriteEngine On

  # http://anything -> https://www.
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

  # https://bare-domain -> https://www.
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} !^localhost [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /index.html -> / (one URL per page)
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [L,R=301]
</IfModule>

# ---- Security headers ------------------------------------------------------
# The page CSP (script/style hashes) ships as a <meta> tag generated by Astro.
# This header adds what a <meta> CSP can't express; browsers enforce both.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>
ServerSignature Off

# ---- Types -----------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType application/octet-stream .hdr
  AddType model/gltf-binary .glb
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType text/vtt .vtt
  AddType text/plain .txt
  AddCharset utf-8 .html .css .js .json .txt .xml .webmanifest
</IfModule>

# ---- Compression -----------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript text/javascript application/json application/manifest+json application/xml image/svg+xml application/octet-stream model/gltf-binary
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/manifest+json application/xml image/svg+xml application/octet-stream model/gltf-binary
</IfModule>

# ---- Caching ---------------------------------------------------------------
<IfModule mod_headers.c>
  # Content-hashed build output never changes under the same name.
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Unhashed assets (model, HDR, labels, icons, video): a month, then revalidate.
  <FilesMatch "\.(glb|hdr|webp|png|jpg|jpeg|avif|ico|woff2|mp4|webm|vtt)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # Pages always revalidate, so a deploy shows up at once.
  <FilesMatch "\.(html|xml|txt|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # The contact form handler's replies are never cached (it also says so itself).
  <Files "contact.php">
    Header set Cache-Control "no-store"
  </Files>
</IfModule>
